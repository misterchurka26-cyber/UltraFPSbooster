-- PLAYER CHARACTERS
--========================================================

local function setupPlayer(playerObject)
    if playerObject.Character then
        task.defer(function()
            optimizeCharacterModel(playerObject.Character)
        end)
    end

    playerObject.CharacterAdded:Connect(function(character)
        task.wait(0.2)
        optimizeCharacterModel(character)
    end)
end

for _, plr in ipairs(Players:GetPlayers()) do
    setupPlayer(plr)
end

Players.PlayerAdded:Connect(setupPlayer)

--========================================================
-- НОВЫЕ ДЕТИ ПЕРСОНАЖА: ACCESSORY/CLOTHING/ANIMATOR
--========================================================

local function watchCharacter(character)
    if not character or not character:IsA("Model") then
        return
    end

    character.ChildAdded:Connect(function(obj)
        task.defer(function()
            if not obj or not obj.Parent then
                return
            end

            if CONFIG.RemoveAccessories and obj:IsA("Accessory") then
                pcall(function() obj:Destroy() end)
                return
            end

            if CONFIG.RemoveClothing then
                if obj:IsA("Shirt")
                    or obj:IsA("Pants")
                    or obj:IsA("ShirtGraphic") then
                    pcall(function() obj:Destroy() end)
                    return
                end
            end

            if CONFIG.RemoveCharacterMeshes and obj:IsA("CharacterMesh") then
                pcall(function() obj:Destroy() end)
                return
            end

            if CONFIG.RemoveTools and obj:IsA("Tool") then
                pcall(function() obj:Destroy() end)
                return
            end

            if obj:IsA("Animator") then
                hookAnimator(obj)
            elseif obj:IsA("Animation") then
                zeroAnimation(obj)
            end

            applySingleCharacterColor(character)
        end)
    end)
end

for _, plr in ipairs(Players:GetPlayers()) do
    if plr.Character then
        watchCharacter(plr.Character)
    end

    plr.CharacterAdded:Connect(function(character)
        watchCharacter(character)
    end)
end

Players.PlayerAdded:Connect(function(plr)
    plr.CharacterAdded:Connect(function(character)
        watchCharacter(character)
    end)
end)

