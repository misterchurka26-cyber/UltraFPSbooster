--========================================================
-- LIGHTING
--========================================================

local function optimizeLighting()
    pcall(function() Lighting.GlobalShadows = false end)
    pcall(function() Lighting.EnvironmentDiffuseScale = 0 end)
    pcall(function() Lighting.EnvironmentSpecularScale = 0 end)
    pcall(function() Lighting.Brightness = 1 end)
    pcall(function() Lighting.ShadowSoftness = 0 end)
    pcall(function() Lighting.Technology = Enum.Technology.Compatibility end)

    if CONFIG.DisablePostEffects then
        for _, obj in ipairs(Lighting:GetChildren()) do
            if obj:IsA("BloomEffect")
                or obj:IsA("BlurEffect")
                or obj:IsA("DepthOfFieldEffect")
                or obj:IsA("SunRaysEffect") then
                pcall(function() obj.Enabled = false end)
            elseif obj:IsA("ColorCorrectionEffect") and obj.Name ~= "UltraFPS_Dark" then
                pcall(function() obj.Enabled = false end)
            end
        end
    end

    if CONFIG.DarkenScreen then
        local color = Lighting:FindFirstChild("UltraFPS_Dark")

        if not color then
            color = Instance.new("ColorCorrectionEffect")
            color.Name = "UltraFPS_Dark"
            color.Parent = Lighting
        end

        color.Enabled = true
        color.Brightness = -0.08
        color.Contrast = -0.05
        color.Saturation = -0.15
    end

    if CONFIG.UseFog then
        pcall(function()
            Lighting.FogColor = Color3.fromRGB(40, 40, 40)
            Lighting.FogStart = 80
            Lighting.FogEnd = 250
        end)
    end
end

optimizeLighting()

--========================================================
-- АНИМАЦИИ: БЛОКИРУЕМ ВСЕ Animator
-- Работает для игроков, Brainrots, NPC, монстров и т.д.
--========================================================

local hookedAnimators = setmetatable({}, { __mode = "k" })

local function stopAnimationsFromAnimator(animator)
    if not animator or not animator:IsA("Animator") then
        return
    end

    pcall(function()
        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
            if track then
                pcall(function()
                    track:Stop(0)
                end)
            end
        end
    end)
end

local function zeroAnimation(obj)
    if not CONFIG.SetAnimationIdsToZero then
        return
    end

    if obj:IsA("Animation") then
        pcall(function()
            obj.AnimationId = "rbxassetid://0"
        end)
    end
end

local function hookAnimator(animator)
    if not CONFIG.DisableAnimations then
        return
    end

    if not animator or not animator:IsA("Animator") then
        return
    end

    stopAnimationsFromAnimator(animator)

    if hookedAnimators[animator] then
        return
    end

    hookedAnimators[animator] = true

    pcall(function()
        animator.AnimationPlayed:Connect(function(track)
            if not CONFIG.DisableAnimations then
                return
            end

            pcall(function()
                track:Stop(0)
            end)
        end)
    end)

    if CONFIG.DisableAnimator then
        pcall(function()
            animator.Parent = nil
        end)
    end
end

--========================================================
-- ВИЗУАЛ ПЕРСОНАЖА: аксессуары/одежда -> один цвет
--========================================================

local function getTorsoColor(character)
    local torso = character:FindFirstChild("Torso")
        or character:FindFirstChild("UpperTorso")
        or character:FindFirstChild("LowerTorso")

    if torso and torso:IsA("BasePart") then
        return torso.Color
    end

    local root = character:FindFirstChild("HumanoidRootPart")
    if root and root:IsA("BasePart") then
        return root.Color
    end

    local head = character:FindFirstChild("Head")
    if head and head:IsA("BasePart") then
        return head.Color
    end

    return Color3.fromRGB(128, 128, 128)
end

local function applySingleCharacterColor(character)
    if not CONFIG.SingleCharacterColor then
        return
    end

    local torsoColor = getTorsoColor(character)

    for _, obj in ipairs(character:GetDescendants()) do
        if obj:IsA("BasePart") then
            pcall(function()
                obj.Color = torsoColor
            end)
        end
    end

    -- Не даём BodyColors вернуть разные цвета на следующем обновлении
    local bodyColors = character:FindFirstChildOfClass("BodyColors")
    if bodyColors then
        local brick = BrickColor.new(torsoColor)

        pcall(function() bodyColors.HeadColor = brick end)
        pcall(function() bodyColors.TorsoColor = brick end)
        pcall(function() bodyColors.LeftArmColor = brick end)
        pcall(function() bodyColors.RightArmColor = brick end)
        pcall(function() bodyColors.LeftLegColor = brick end)
        pcall(function() bodyColors.RightLegColor = brick end)
    end
end

local function removeCharacterVisuals(character)
    if not character then
        return
    end

    for _, obj in ipairs(character:GetChildren()) do
        if CONFIG.RemoveAccessories and obj:IsA("Accessory") then
            pcall(function() obj:Destroy() end)
            continue
        end

        if CONFIG.RemoveClothing then
            if obj:IsA("Shirt")
                or obj:IsA("Pants")
                or obj:IsA("ShirtGraphic") then
                pcall(function() obj:Destroy() end)
                continue
            end
        end

        if CONFIG.RemoveCharacterMeshes and obj:IsA("CharacterMesh") then
            pcall(function() obj:Destroy() end)
            continue
        end

        if CONFIG.RemoveTools and obj:IsA("Tool") then
            pcall(function() obj:Destroy() end)
        end
    end

    -- Дополнительная чистка аксессуарных частей, если они уже попали внутрь
    if CONFIG.RemoveAccessories then
        for _, obj in ipairs(character:GetDescendants()) do
            if obj:IsA("SurfaceAppearance") then
                pcall(function() obj:Destroy() end)
            end
        end
    end
end

local function optimizeCharacterModel(character)
    if not character or not character:IsA("Model") then
        return
    end

    removeCharacterVisuals(character)
    applySingleCharacterColor(character)

    for _, obj in ipairs(character:GetDescendants()) do
        if obj:IsA("Animator") then
            hookAnimator(obj)
        elseif obj:IsA("Animation") then
            zeroAnimation(obj)
        end
    end
end

--========================================================
-- GUI КАРТИНКИ
--========================================================

local function optimizeGuiImage(obj)
    if not CONFIG.PixelateGuiImages then
        return
    end

    if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
        pcall(function()
            obj.ResampleMode = Enum.ResamplerMode.Pixelated
        end)

        if CONFIG.RemoveGuiImages then
            pcall(function()
                obj.Image = "rbxassetid://0"
            end)
        end
    end
end

--========================================================
-- ОБРАБОТКА ОБЪЕКТОВ
--========================================================

local function optimizeObject(obj)
    -- АНИМАЦИИ
    if obj:IsA("Animator") then
        hookAnimator(obj)
    elseif obj:IsA("Animation") then
        zeroAnimation(obj)
    end

    -- BASEPART
    if obj:IsA("BasePart") then
        if CONFIG.RemoveShadows then
            pcall(function() obj.CastShadow = false end)
        end

        if CONFIG.RemoveReflectance then
            pcall(function() obj.Reflectance = 0 end)
        end

        if CONFIG.SimplifyMaterials then
            pcall(function() obj.Material = CONFIG.Material end)
        end

        if obj:IsA("MeshPart") then
            if CONFIG.RemoveTextures then
                pcall(function() obj.TextureID = "" end)
            end

            pcall(function()
                obj.RenderFidelity = Enum.RenderFidelity.Performance
            end)
        end
    end

    -- TEXTURE / DECAL / SURFACE APPEARANCE
    if CONFIG.RemoveTextures then
        if obj:IsA("Decal") or obj:IsA("Texture") then
            pcall(function() obj.Transparency = 1 end)
        end

        if obj:IsA("SurfaceAppearance") and CONFIG.RemoveSurfaceAppearance then
            pcall(function() obj:Destroy() end)
            return
        end
    end

    -- PARTICLES
    if CONFIG.DisableParticles then
        if obj:IsA("ParticleEmitter")
            or obj:IsA("Smoke")
            or obj:IsA("Fire")
            or obj:IsA("Sparkles") then
            pcall(function() obj.Enabled = false end)
        end
    end

    -- TRAIL
    if CONFIG.DisableTrails and obj:IsA("Trail") then
        pcall(function() obj.Enabled = false end)
    end

    -- BEAM
    if CONFIG.DisableBeams and obj:IsA("Beam") then
        pcall(function() obj.Enabled = false end)
    end

    -- LIGHTS
    if CONFIG.DisableLights then
        if obj:IsA("PointLight")
            or obj:IsA("SpotLight")
            or obj:IsA("SurfaceLight") then
            pcall(function() obj.Enabled = false end)
        end
    end

    -- POST EFFECTS
    if CONFIG.DisablePostEffects then
        if obj:IsA("BloomEffect")
            or obj:IsA("BlurEffect")
            or obj:IsA("DepthOfFieldEffect")
            or obj:IsA("SunRaysEffect") then
            pcall(function() obj.Enabled = false end)
        end
    end

    -- VIDEO
    if CONFIG.DisableVideo and obj:IsA("VideoFrame") then
        pcall(function() obj.Playing = false end)
        pcall(function() obj.Visible = false end)
    end

    -- GUI IMAGES
    if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
        optimizeGuiImage(obj)
    end
end

--========================================================
-- ОБРАБОТАТЬ УЖЕ СУЩЕСТВУЮЩЕЕ
--========================================================

for _, obj in ipairs(game:GetDescendants()) do
    optimizeObject(obj)
end

