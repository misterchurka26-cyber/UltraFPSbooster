-- ИГРОВЫЕ ПЕРСОНАЖИ / BRAINROTS / NPC
--========================================================

local function looksLikeCharacterModel(model)
    if not model:IsA("Model") then
        return false
    end

    if model:FindFirstChildOfClass("Humanoid") then
        return true
    end

    if model:FindFirstChildOfClass("Animator", true) then
        return true
    end

    return false
end

for _, obj in ipairs(Workspace:GetDescendants()) do
    if obj:IsA("Model") and looksLikeCharacterModel(obj) then
        optimizeCharacterModel(obj)
    end
end

--========================================================
-- НОВЫЕ OBJECT
--========================================================

game.DescendantAdded:Connect(function(obj)
    task.defer(function()
        if not obj or not obj.Parent then
            return
        end

        optimizeObject(obj)

        -- Если появился/изменился персонаж, поднимаемся до Model
        local model = obj:FindFirstAncestorOfClass("Model")
        if model and model.Parent and looksLikeCharacterModel(model) then
            optimizeCharacterModel(model)
        end
    end)
end)

