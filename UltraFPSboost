--========================================================
-- ULTRA FPS BOOST EXTREME v2
-- EVENT-DRIVEN / LOW STUTTER
--
-- Основной принцип:
--   1. НЕТ постоянного game:GetDescendants()
--   2. НЕТ повторного полного скана каждые N секунд
--   3. Каждый объект оптимизируется один раз
--   4. Новые объекты обрабатываются только при появлении
--   5. Большие пачки объектов обрабатываются частями
--========================================================

local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local UserSettings = game:GetService("UserSettings")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer

--========================================================
-- CONFIG
--========================================================

local CONFIG = {

	--====================================================
	-- EXTREME GRAPHICS
	--====================================================

	RemoveTextures = true,
	RemoveSurfaceAppearance = true,

	RemoveShadows = true,
	SimplifyMaterials = true,
	RemoveReflectance = true,

	DisableParticles = true,
	DisableTrails = true,
	DisableBeams = true,
	DisableLights = true,
	DisablePostEffects = true,
	DisableVideo = true,

	--====================================================
	-- ANIMATIONS
	--====================================================

	DisableAnimations = true,
	SetAnimationIdsToZero = true,

	-- false = не удаляет Animator, безопаснее
	DisableAnimator = false,

	--====================================================
	-- CHARACTER
	--====================================================

	RemoveAccessories = true,
	RemoveClothing = true,
	RemoveCharacterMeshes = false,

	SingleCharacterColor = true,

	--====================================================
	-- TOOLS
	--====================================================

	RemoveTools = false,

	--====================================================
	-- TERRAIN
	--====================================================

	SimplifyTerrain = true,

	--====================================================
	-- SCREEN
	--====================================================

	-- Для максимального FPS лучше false.
	-- ColorCorrection тоже является post-effect.
	DarkenScreen = false,

	UseFog = false,

	--====================================================
	-- GUI
	--====================================================

	PixelateGuiImages = true,
	RemoveGuiImages = false,

	--====================================================
	-- MATERIAL
	--====================================================

	Material = Enum.Material.Plastic,

	--====================================================
	-- BATCH PROCESSING
	--====================================================

	-- Сколько новых объектов обрабатывать за один Heartbeat.
	-- Меньше = меньше фризов, но оптимизация немного медленнее.
	ObjectsPerHeartbeat = 100,
}

--========================================================
-- CACHE
--========================================================

local optimizedObjects = setmetatable({}, {
	__mode = "k"
})

local optimizedCharacters = setmetatable({}, {
	__mode = "k"
})

local hookedAnimators = setmetatable({}, {
	__mode = "k"
})

local watchedCharacters = setmetatable({}, {
	__mode = "k"
})

local zeroedAnimations = setmetatable({}, {
	__mode = "k"
})

local pendingObjects = {}
local pendingSet = setmetatable({}, {
	__mode = "k"
})

--========================================================
-- SAFE HELPER
--========================================================

local function safe(fn)
	local ok = pcall(fn)
	return ok
end

--========================================================
-- GRAPHICS QUALITY
--========================================================

safe(function()
	local gameSettings = UserSettings():GetService("UserGameSettings")
	gameSettings.GraphicsQualityLevel = 1
end)

safe(function()
	settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
end)

--========================================================
-- LIGHTING
-- Делается ТОЛЬКО один раз
--========================================================

local function optimizeLighting()

	safe(function()
		Lighting.GlobalShadows = false
	end)

	safe(function()
		Lighting.EnvironmentDiffuseScale = 0
	end)

	safe(function()
		Lighting.EnvironmentSpecularScale = 0
	end)

	safe(function()
		Lighting.ShadowSoftness = 0
	end)

	safe(function()
		Lighting.Technology = Enum.Technology.Compatibility
	end)

	if CONFIG.DisablePostEffects then
		for _, obj in ipairs(Lighting:GetChildren()) do

			if obj:IsA("BloomEffect")
				or obj:IsA("BlurEffect")
				or obj:IsA("DepthOfFieldEffect")
				or obj:IsA("SunRaysEffect")
				or obj:IsA("ColorCorrectionEffect") then

				safe(function()
					obj.Enabled = false
				end)
			end
		end
	end

	-- Максимальный FPS -> этот эффект выключен.
	if CONFIG.DarkenScreen then

		local color = Lighting:FindFirstChild("UltraFPS_Dark")

		if not color then
			color = Instance.new("ColorCorrectionEffect")
			color.Name = "UltraFPS_Dark"
			color.Parent = Lighting
		end

		safe(function()
			color.Enabled = true
			color.Brightness = -0.08
			color.Contrast = -0.05
			color.Saturation = -0.15
		end)
	end

	if CONFIG.UseFog then

		safe(function()
			Lighting.FogColor = Color3.fromRGB(40, 40, 40)
			Lighting.FogStart = 80
			Lighting.FogEnd = 250
		end)

	end
end

optimizeLighting()

--========================================================
-- ANIMATION
--========================================================

local function stopAnimatorTracks(animator)

	if not animator then
		return
	end

	if not animator:IsA("Animator") then
		return
	end

	safe(function()

		local tracks = animator:GetPlayingAnimationTracks()

		for _, track in ipairs(tracks) do
			if track then
				pcall(function()
					track:Stop(0)
				end)
			end
		end

	end)
end

local function zeroAnimation(animation)

	if not CONFIG.SetAnimationIdsToZero then
		return
	end

	if zeroedAnimations[animation] then
		return
	end

	zeroedAnimations[animation] = true

	safe(function()
		animation.AnimationId = "rbxassetid://0"
	end)
end

local function hookAnimator(animator)

	if not CONFIG.DisableAnimations then
		return
	end

	if not animator:IsA("Animator") then
		return
	end

	if hookedAnimators[animator] then
		return
	end

	hookedAnimators[animator] = true

	-- Сразу остановить уже играющие
	stopAnimatorTracks(animator)

	-- Больше никаких циклов каждые 0.5 сек.
	safe(function()

		animator.AnimationPlayed:Connect(function(track)

			if not CONFIG.DisableAnimations then
				return
			end

			pcall(function()
				track:Stop(0)
			end)

		end)

	end)

	if CONFIG.DisableAnimator then

		-- Включать только если действительно необходимо.
		safe(function()
			animator.Parent = nil
		end)

	end
end

--========================================================
-- CHARACTER COLOR
--========================================================

local function getCharacterColor(character)

	local torso =
		character:FindFirstChild("Torso")
		or character:FindFirstChild("UpperTorso")
		or character:FindFirstChild("LowerTorso")

	if torso and torso:IsA("BasePart") then
		return torso.Color
	end

	local root = character:FindFirstChild("HumanoidRootPart")

	if root and root:IsA("BasePart") then
		return root.Color
	end

	local head = character:FindFirstChild("Head")

	if head and head:IsA("BasePart") then
		return head.Color
	end

	return Color3.fromRGB(128, 128, 128)
end

local function applySingleCharacterColor(character)

	if not CONFIG.SingleCharacterColor then
		return
	end

	local torsoColor = getCharacterColor(character)

	-- Только один раз на обработку персонажа.
	for _, obj in ipairs(character:GetDescendants()) do

		if obj:IsA("BasePart") then

			safe(function()
				obj.Color = torsoColor
			end)

		end
	end

	local bodyColors = character:FindFirstChildOfClass("BodyColors")

	if bodyColors then

		local brick = BrickColor.new(torsoColor)

		safe(function()
			bodyColors.HeadColor = brick
		end)

		safe(function()
			bodyColors.TorsoColor = brick
		end)

		safe(function()
			bodyColors.LeftArmColor = brick
		end)

		safe(function()
			bodyColors.RightArmColor = brick
		end)

		safe(function()
			bodyColors.LeftLegColor = brick
		end)

		safe(function()
			bodyColors.RightLegColor = brick
		end)

	end
end

--========================================================
-- CHARACTER VISUALS
--========================================================

local function removeCharacterVisuals(character)

	if not character then
		return
	end

	-- Только прямые дети.
	for _, obj in ipairs(character:GetChildren()) do

		if CONFIG.RemoveAccessories and obj:IsA("Accessory") then

			safe(function()
				obj:Destroy()
			end)

		elseif CONFIG.RemoveClothing
			and (
				obj:IsA("Shirt")
				or obj:IsA("Pants")
				or obj:IsA("ShirtGraphic")
			) then

			safe(function()
				obj:Destroy()
			end)

		elseif CONFIG.RemoveCharacterMeshes
			and obj:IsA("CharacterMesh") then

			safe(function()
				obj:Destroy()
			end)

		elseif CONFIG.RemoveTools
			and obj:IsA("Tool") then

			safe(function()
				obj:Destroy()
			end)

		end
	end
end

--========================================================
-- CHARACTER DETECTION
--========================================================

local function looksLikeCharacterModel(model)

	if not model:IsA("Model") then
		return false
	end

	if model:FindFirstChildOfClass("Humanoid") then
		return true
	end

	if model:FindFirstChildOfClass("Animator", true) then
		return true
	end

	return false
end

--========================================================
-- WATCH CHARACTER
--========================================================

local function watchCharacter(character)

	if not character then
		return
	end

	if watchedCharacters[character] then
		return
	end

	watchedCharacters[character] = true

	character.ChildAdded:Connect(function(child)

		-- Очень лёгкая обработка.
		task.defer(function()

			if not child or not child.Parent then
				return
			end

			-- ACCESSORY
			if CONFIG.RemoveAccessories and child:IsA("Accessory") then

				safe(function()
					child:Destroy()
				end)

				return
			end

			-- CLOTHING
			if CONFIG.RemoveClothing then

				if child:IsA("Shirt")
					or child:IsA("Pants")
					or child:IsA("ShirtGraphic") then

					safe(function()
						child:Destroy()
					end)

					return
				end
			end

			-- CHARACTER MESH
			if CONFIG.RemoveCharacterMeshes
				and child:IsA("CharacterMesh") then

				safe(function()
					child:Destroy()
				end)

				return
			end

			-- TOOL
			if CONFIG.RemoveTools and child:IsA("Tool") then

				safe(function()
					child:Destroy()
				end)

				return
			end

			-- ANIMATOR
			if child:IsA("Animator") then
				hookAnimator(child)
			end

			-- ANIMATION
			if child:IsA("Animation") then
				zeroAnimation(child)
			end

		end)

	end)

end

--========================================================
-- GUI IMAGE
--========================================================

local function optimizeGuiImage(obj)

	if not CONFIG.PixelateGuiImages then
		return
	end

	if not (obj:IsA("ImageLabel") or obj:IsA("ImageButton")) then
		return
	end

	safe(function()
		obj.ResampleMode = Enum.ResamplerMode.Pixelated
	end)

	if CONFIG.RemoveGuiImages then

		safe(function()
			obj.Image = "rbxassetid://0"
		end)

	end
end

--========================================================
-- OBJECT OPTIMIZER
--========================================================

local function optimizeObject(obj)

	if not obj then
		return
	end

	if not obj.Parent then
		return
	end

	-- Не обрабатывать объект бесконечно.
	if optimizedObjects[obj] then
		return
	end

	optimizedObjects[obj] = true

	--====================================================
	-- ANIMATION
	--====================================================

	if obj:IsA("Animator") then

		hookAnimator(obj)

	elseif obj:IsA("Animation") then

		zeroAnimation(obj)

	end

	--====================================================
	-- BASEPART
	--====================================================

	if obj:IsA("BasePart") then

		if CONFIG.RemoveShadows then
			safe(function()
				obj.CastShadow = false
			end)
		end

		if CONFIG.RemoveReflectance then
			safe(function()
				obj.Reflectance = 0
			end)
		end

		if CONFIG.SimplifyMaterials then
			safe(function()
				obj.Material = CONFIG.Material
			end)
		end

	end

	--====================================================
	-- MESHPART
	--====================================================

	if obj:IsA("MeshPart") then

		if CONFIG.RemoveTextures then

			safe(function()
				obj.TextureID = ""
			end)

		end

		safe(function()
			obj.RenderFidelity = Enum.RenderFidelity.Performance
		end)

	end

	--====================================================
	-- TEXTURES
	--====================================================

	if CONFIG.RemoveTextures then

		if obj:IsA("Decal")
			or obj:IsA("Texture") then

			safe(function()
				obj.Transparency = 1
			end)

		end

	end

	--====================================================
	-- SURFACE APPEARANCE
	--====================================================

	if CONFIG.RemoveSurfaceAppearance
		and obj:IsA("SurfaceAppearance") then

		safe(function()
			obj:Destroy()
		end)

		return
	end

	--====================================================
	-- PARTICLES
	--====================================================

	if CONFIG.DisableParticles then

		if obj:IsA("ParticleEmitter")
			or obj:IsA("Smoke")
			or obj:IsA("Fire")
			or obj:IsA("Sparkles") then

			safe(function()
				obj.Enabled = false
			end)

		end

	end

	--====================================================
	-- TRAIL
	--====================================================

	if CONFIG.DisableTrails and obj:IsA("Trail") then

		safe(function()
			obj.Enabled = false
		end)

	end

	--====================================================
	-- BEAM
	--====================================================

	if CONFIG.DisableBeams and obj:IsA("Beam") then

		safe(function()
			obj.Enabled = false
		end)

	end

	--====================================================
	-- LIGHT
	--====================================================

	if CONFIG.DisableLights then

		if obj:IsA("PointLight")
			or obj:IsA("SpotLight")
			or obj:IsA("SurfaceLight") then

			safe(function()
				obj.Enabled = false
			end)

		end

	end

	--====================================================
	-- POST EFFECT
	--====================================================

	if CONFIG.DisablePostEffects then

		if obj:IsA("BloomEffect")
			or obj:IsA("BlurEffect")
			or obj:IsA("DepthOfFieldEffect")
			or obj:IsA("SunRaysEffect")
			or obj:IsA("ColorCorrectionEffect") then

			-- Не трогаем наш собственный эффект, если включён.
			if obj.Name ~= "UltraFPS_Dark" then

				safe(function()
					obj.Enabled = false
				end)

			end

		end

	end

	--====================================================
	-- VIDEO
	--====================================================

	if CONFIG.DisableVideo and obj:IsA("VideoFrame") then

		safe(function()
			obj.Playing = false
		end)

		safe(function()
			obj.Visible = false
		end)

	end

	--====================================================
	-- GUI
	--====================================================

	if obj:IsA("ImageLabel")
		or obj:IsA("ImageButton") then

		optimizeGuiImage(obj)

	end
end

--========================================================
-- CHARACTER OPTIMIZER
--========================================================

local function optimizeCharacterModel(character)

	if not character then
		return
	end

	if not character:IsA("Model") then
		return
	end

	if optimizedCharacters[character] then
		return
	end

	if not character.Parent then
		return
	end

	optimizedCharacters[character] = true

	-- Следим за будущими предметами
	watchCharacter(character)

	-- Удаляем одежду/аксессуары
	removeCharacterVisuals(character)

	-- Все части одного цвета
	applySingleCharacterColor(character)

	-- Только один первоначальный проход
	for _, obj in ipairs(character:GetDescendants()) do

		if obj:IsA("Animator") then

			hookAnimator(obj)

		elseif obj:IsA("Animation") then

			zeroAnimation(obj)

		else

			optimizeObject(obj)

		end
	end
end

--========================================================
-- QUEUE
-- Объекты добавляются в очередь, а не обрабатываются
-- огромными пачками прямо внутри DescendantAdded.
--========================================================

local function queueObject(obj)

	if not obj then
		return
	end

	if optimizedObjects[obj] then
		return
	end

	if pendingSet[obj] then
		return
	end

	pendingSet[obj] = true
	table.insert(pendingObjects, obj)
end

--========================================================
-- INITIAL SCAN
-- Один начальный проход.
--========================================================

for _, obj in ipairs(game:GetDescendants()) do
	queueObject(obj)
end

--========================================================
-- PROCESS QUEUE
--========================================================

local queueIndex = 1

RunService.Heartbeat:Connect(function()

	local processed = 0

	while queueIndex <= #pendingObjects
		and processed < CONFIG.ObjectsPerHeartbeat do

		local obj = pendingObjects[queueIndex]

		pendingObjects[queueIndex] = nil
		queueIndex += 1

		if obj then

			pendingSet[obj] = nil

			if obj.Parent then

				optimizeObject(obj)

			end
		end

		processed += 1
	end

	-- Освобождаем таблицу после полной обработки.
	if queueIndex > #pendingObjects then

		table.clear(pendingObjects)
		queueIndex = 1

	end

end)

--========================================================
-- NEW OBJECTS
--========================================================

game.DescendantAdded:Connect(function(obj)

	if not obj then
		return
	end

	-- Не делаем тяжёлую работу прямо в событии.
	queueObject(obj)

	-- Если появился новый Model, проверяем только его.
	if obj:IsA("Model") then

		task.defer(function()

			if obj.Parent and looksLikeCharacterModel(obj) then
				optimizeCharacterModel(obj)
			end

		end)

	end

end)

--========================================================
-- TERRAIN
--========================================================

if CONFIG.SimplifyTerrain then

	local terrain = Workspace:FindFirstChildOfClass("Terrain")

	if terrain then

		safe(function()
			terrain.WaterWaveSize = 0
		end)

		safe(function()
			terrain.WaterWaveSpeed = 0
		end)

		safe(function()
			terrain.WaterReflectance = 0
		end)

		safe(function()
			terrain.WaterTransparency = 1
		end)

	end
end

--========================================================
-- PLAYER CHARACTERS
--========================================================

local function setupPlayer(player)

	if not player then
		return
	end

	-- Уже загружен
	if player.Character then

		task.defer(function()

			if player.Character then
				optimizeCharacterModel(player.Character)
			end

		end)

	end

	player.CharacterAdded:Connect(function(character)

		-- Не ждём 0.2 сек специально.
		task.defer(function()
			optimizeCharacterModel(character)
		end)

	end)
end

for _, player in ipairs(Players:GetPlayers()) do
	setupPlayer(player)
end

Players.PlayerAdded:Connect(setupPlayer)

--========================================================
-- EXISTING NPC / BRAINROTS
--========================================================

for _, obj in ipairs(Workspace:GetDescendants()) do

	if obj:IsA("Model") and looksLikeCharacterModel(obj) then

		task.defer(function()
			if obj.Parent then
				optimizeCharacterModel(obj)
			end
		end)

	end
end

--========================================================
-- LIGHTING OBJECTS ADDED LATER
--========================================================

Lighting.ChildAdded:Connect(function(obj)

	task.defer(function()

		if not obj or not obj.Parent then
			return
		end

		if CONFIG.DisablePostEffects then

			if obj:IsA("BloomEffect")
				or obj:IsA("BlurEffect")
				or obj:IsA("DepthOfFieldEffect")
				or obj:IsA("SunRaysEffect")
				or obj:IsA("ColorCorrectionEffect") then

				if obj.Name ~= "UltraFPS_Dark" then

					safe(function()
						obj.Enabled = false
					end)

				end
			end
		end

	end)

end)

