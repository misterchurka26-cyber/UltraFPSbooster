--========================================================
-- ULTRA FPS BOOST EXTREME
-- Агрессивное снижение графики + отключение анимаций
--========================================================

local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local UserSettings = game:GetService("UserSettings")

local player = Players.LocalPlayer

--========================================================
-- НАСТРОЙКИ
--========================================================

local CONFIG = {

	-- ТЕКСТУРЫ
	RemoveTextures = true,
	RemoveSurfaceAppearance = true,

	-- ГРАФИКА
	RemoveShadows = true,
	SimplifyMaterials = true,
	RemoveReflectance = true,

	-- ЭФФЕКТЫ
	DisableParticles = true,
	DisableTrails = true,
	DisableBeams = true,
	DisableLights = true,
	DisablePostEffects = true,

	-- АНИМАЦИИ
	DisableAnimations = true,
	DisableAnimationTracks = true,
	DisableAnimator = false,

	-- TERRAIN
	SimplifyTerrain = true,

	-- ЭКРАН
	DarkenScreen = true,

	-- ТУМАН
	UseFog = false,

	-- МАТЕРИАЛ
	Material = Enum.Material.Plastic,

	-- ПОВТОРНАЯ ПРОВЕРКА
	RecheckInterval = 5,
}

--========================================================
-- GRAPHICS QUALITY
--========================================================

pcall(function()
	local gameSettings = UserSettings():GetService("UserGameSettings")
	gameSettings.GraphicsQualityLevel = 1
end)

pcall(function()
	settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
end)

--========================================================
-- LIGHTING
--========================================================

local function optimizeLighting()

	pcall(function()
		Lighting.GlobalShadows = false
	end)

	pcall(function()
		Lighting.EnvironmentDiffuseScale = 0
	end)

	pcall(function()
		Lighting.EnvironmentSpecularScale = 0
	end)

	pcall(function()
		Lighting.Brightness = 1
	end)

	pcall(function()
		Lighting.ShadowSoftness = 0
	end)

	pcall(function()
		Lighting.Technology = Enum.Technology.Compatibility
	end)

	-- Отключить дорогие эффекты
	if CONFIG.DisablePostEffects then

		for _, obj in ipairs(Lighting:GetChildren()) do

			if obj:IsA("BloomEffect")
				or obj:IsA("BlurEffect")
				or obj:IsA("DepthOfFieldEffect")
				or obj:IsA("SunRaysEffect") then

				obj.Enabled = false

			elseif obj:IsA("ColorCorrectionEffect") then

				if obj.Name ~= "UltraFPS_Dark" then
					obj.Enabled = false
				end
			end
		end
	end

	--====================================================
	-- ТЕМНЕЕ
	--====================================================

	if CONFIG.DarkenScreen then

		local color = Lighting:FindFirstChild("UltraFPS_Dark")

		if not color then

			color = Instance.new("ColorCorrectionEffect")
			color.Name = "UltraFPS_Dark"
			color.Parent = Lighting
		end

		color.Enabled = true
		color.Brightness = -0.08
		color.Contrast = -0.05
		color.Saturation = -0.15
	end

	--====================================================
	-- FOG
	--====================================================

	if CONFIG.UseFog then

		pcall(function()

			Lighting.FogColor = Color3.fromRGB(40, 40, 40)
			Lighting.FogStart = 80
			Lighting.FogEnd = 250

		end)
	end
end

optimizeLighting()

--========================================================
-- ОСТАНОВКА АНИМАЦИЙ
--========================================================

local function stopAnimationsFromAnimator(animator)

	if not animator or not animator:IsA("Animator") then
		return
	end

	-- Остановить уже запущенные AnimationTrack
	pcall(function()

		for _, track in ipairs(animator:GetPlayingAnimationTracks()) do

			if track then
				pcall(function()
					track:Stop(0)
				end)
			end

		end

	end)
end

--========================================================
-- ОТКЛЮЧИТЬ АНИМАЦИИ В ОБЪЕКТЕ
--========================================================

local function optimizeAnimator(obj)

	if not CONFIG.DisableAnimations then
		return
	end

	-- Animator
	if obj:IsA("Animator") then

		stopAnimationsFromAnimator(obj)

		if CONFIG.DisableAnimator then
			pcall(function()
				obj.Parent = nil
			end)
		end

		return
	end

	-- AnimationTrack напрямую как Instance не существует
	-- поэтому обрабатываем Animator выше.
end

--========================================================
-- ОБРАБОТКА ОБЪЕКТОВ
--========================================================

local function optimizeObject(obj)

	--====================================================
	-- АНИМАЦИИ
	--====================================================

	if obj:IsA("Animator") then
		optimizeAnimator(obj)
	end

	--====================================================
	-- BASEPART
	--====================================================

	if obj:IsA("BasePart") then

		if CONFIG.RemoveShadows then
			pcall(function()
				obj.CastShadow = false
			end)
		end

		if CONFIG.RemoveReflectance then
			pcall(function()
				obj.Reflectance = 0
			end)
		end

		if CONFIG.SimplifyMaterials then

			pcall(function()
				obj.Material = CONFIG.Material
			end)

		end

		--================================================
		-- MESHPART
		--================================================

		if obj:IsA("MeshPart") then

			if CONFIG.RemoveTextures then

				pcall(function()
					obj.TextureID = ""
				end)

			end

			pcall(function()
				obj.RenderFidelity = Enum.RenderFidelity.Performance
			end)
		end
	end

	--====================================================
	-- TEXTURE / DECAL
	--====================================================

	if CONFIG.RemoveTextures then

		if obj:IsA("Decal") or obj:IsA("Texture") then

			pcall(function()
				obj.Transparency = 1
			end)

		end

		if obj:IsA("SurfaceAppearance") then

			if CONFIG.RemoveSurfaceAppearance then
				pcall(function()
					obj:Destroy()
				end)

				return
			end
		end
	end

	--====================================================
	-- PARTICLES
	--====================================================

	if CONFIG.DisableParticles then

		if obj:IsA("ParticleEmitter")
			or obj:IsA("Smoke")
			or obj:IsA("Fire")
			or obj:IsA("Sparkles") then

			pcall(function()
				obj.Enabled = false
			end)
		end
	end

	--====================================================
	-- TRAIL
	--====================================================

	if CONFIG.DisableTrails then

		if obj:IsA("Trail") then

			pcall(function()
				obj.Enabled = false
			end)

		end
	end

	--====================================================
	-- BEAM
	--====================================================

	if CONFIG.DisableBeams then

		if obj:IsA("Beam") then

			pcall(function()
				obj.Enabled = false
			end)

		end
	end

	--====================================================
	-- LIGHTS
	--====================================================

	if CONFIG.DisableLights then

		if obj:IsA("PointLight")
			or obj:IsA("SpotLight")
			or obj:IsA("SurfaceLight") then

			pcall(function()
				obj.Enabled = false
			end)
		end
	end

	--====================================================
	-- POST EFFECTS
	--====================================================

	if CONFIG.DisablePostEffects then

		if obj:IsA("BloomEffect")
			or obj:IsA("BlurEffect")
			or obj:IsA("DepthOfFieldEffect")
			or obj:IsA("SunRaysEffect") then

			pcall(function()
				obj.Enabled = false
			end)
		end
	end

	--====================================================
	-- VIDEO
	--====================================================

	if obj:IsA("VideoFrame") then

		pcall(function()
			obj.Playing = false
		end)

		pcall(function()
			obj.Visible = false
		end)
	end
end

--========================================================
-- CHARACTERS
--========================================================

local function optimizeCharacter(character)

	if not character then
		return
	end

	for _, obj in ipairs(character:GetDescendants()) do

		-- Parts
		if obj:IsA("BasePart") then

			pcall(function()
				obj.CastShadow = false
			end)

			pcall(function()
				obj.Material = Enum.Material.Plastic
			end)

			pcall(function()
				obj.Reflectance = 0
			end)

		end

		-- Textures
		if obj:IsA("Decal") or obj:IsA("Texture") then

			pcall(function()
				obj.Transparency = 1
			end)

		end

		-- SurfaceAppearance
		if obj:IsA("SurfaceAppearance") then

			pcall(function()
				obj:Destroy()
			end)

		end

		-- Animator
		if obj:IsA("Animator") then

			stopAnimationsFromAnimator(obj)

		end

		-- Effects
		if obj:IsA("ParticleEmitter")
			or obj:IsA("Trail")
			or obj:IsA("Beam")
			or obj:IsA("Smoke")
			or obj:IsA("Fire")
			or obj:IsA("Sparkles") then

			pcall(function()
				obj.Enabled = false
			end)

		end
	end
end

--========================================================
-- ОБРАБОТАТЬ WORKSPACE
--========================================================

for _, obj in ipairs(Workspace:GetDescendants()) do
	optimizeObject(obj)
end

--========================================================
-- НОВЫЕ OBJECT
--========================================================

Workspace.DescendantAdded:Connect(function(obj)

	task.defer(function()

		if not obj or not obj.Parent then
			return
		end

		optimizeObject(obj)

		-- Если добавился Animator,
		-- сразу останавливаем его анимации
		if obj:IsA("Animator") then
			stopAnimationsFromAnimator(obj)
		end

	end)

end)

--========================================================
-- TERRAIN
--========================================================

if CONFIG.SimplifyTerrain then

	local terrain = Workspace:FindFirstChildOfClass("Terrain")

	if terrain then

		pcall(function()
			terrain.WaterWaveSize = 0
		end)

		pcall(function()
			terrain.WaterWaveSpeed = 0
		end)

		pcall(function()
			terrain.WaterReflectance = 0
		end)

		pcall(function()
			terrain.WaterTransparency = 1
		end)

	end
end

--========================================================
-- PLAYER CHARACTER
--========================================================

if player.Character then

	task.defer(function()
		optimizeCharacter(player.Character)
	end)

end

player.CharacterAdded:Connect(function(character)

	task.wait(0.25)

	optimizeCharacter(character)

end)

--========================================================
-- СЛЕДИТЬ ЗА НОВЫМИ АНИМАЦИЯМИ
--========================================================

task.spawn(function()

	while task.wait(0.5) do

		if not CONFIG.DisableAnimations then
			break
		end

		-- Игрок
		if player.Character then

			for _, obj in ipairs(player.Character:GetDescendants()) do

				if obj:IsA("Animator") then
					stopAnimationsFromAnimator(obj)
				end

			end
		end

		-- Остальные персонажи
		for _, otherPlayer in ipairs(Players:GetPlayers()) do

			if otherPlayer.Character then

				for _, obj in ipairs(otherPlayer.Character:GetDescendants()) do

					if obj:IsA("Animator") then
						stopAnimationsFromAnimator(obj)
					end

				end
			end
		end
	end
end)

--========================================================
-- АГРЕССИВНАЯ ПОВТОРНАЯ ОПТИМИЗАЦИЯ
--========================================================

task.spawn(function()

	while task.wait(CONFIG.RecheckInterval) do

		for _, obj in ipairs(Workspace:GetDescendants()) do

			if obj:IsA("SurfaceAppearance") then

				pcall(function()
					obj:Destroy()
				end)

			elseif obj:IsA("ParticleEmitter")
				or obj:IsA("Trail")
				or obj:IsA("Beam")
				or obj:IsA("Smoke")
				or obj:IsA("Fire")
				or obj:IsA("Sparkles") then

				pcall(function()
					obj.Enabled = false
				end)

			elseif obj:IsA("PointLight")
				or obj:IsA("SpotLight")
				or obj:IsA("SurfaceLight") then

				pcall(function()
					obj.Enabled = false
				end)

			elseif obj:IsA("Animator") then

				stopAnimationsFromAnimator(obj)

			elseif obj:IsA("BasePart") then

				pcall(function()
					obj.CastShadow = false
				end)

				pcall(function()
					obj.Reflectance = 0
				end)

				pcall(function()
					obj.Material = Enum.Material.Plastic
				end)

				if obj:IsA("MeshPart") then

					pcall(function()
						obj.TextureID = ""
					end)

					pcall(function()
						obj.RenderFidelity = Enum.RenderFidelity.Performance
					end)

				end
			end
		end

		optimizeLighting()
	end
end)

