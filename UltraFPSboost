--========================================================
-- CONFIG
--========================================================

local MAX_BATCH = 300

-- Тайм-бюджет на обработку новых (застриммленных) объектов
-- за один кадр. Именно это убирает фризы при повороте
-- камеры / быстром беге — большие пачки новых объектов
-- размазываются по нескольким кадрам вместо одного.
local FRAME_BUDGET_SECONDS = 0.0015 -- ~1.5ms
local MAX_PER_FRAME_HARD_CAP = 200  -- защита на случай очень быстрых clock() тиков

