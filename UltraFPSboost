--========================================================
-- ULTRA FPS BOOST EXTREME v3
-- STARTUP ONLY / ZERO PERIODIC SCANS
--
-- ЦЕЛЬ:
--   Максимальный FPS без постоянной нагрузки от оптимизатора.
--
-- ОСНОВНАЯ ИДЕЯ:
--   Оптимизация происходит при загрузке / появлении персонажа.
--   После этого НИКАКИХ Heartbeat / while / регулярных сканов.
--========================================================

local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local UserSettings = game:GetService("UserSettings")

--========================================================
-- CONFIG
--========================================================

local CONFIG = {

	--====================================================
	-- GRAPHICS
	--====================================================

	RemoveTextures = true,
	RemoveSurfaceAppearance = true,

	RemoveShadows = true,
	SimplifyMaterials = true,
	RemoveReflectance = true,

	DisableParticles = true,
	DisableTrails = true,
	DisableBeams = true,
	DisableLights = true,
	DisablePostEffects = true,
	DisableVideo = true,

	--====================================================
	-- ANIMATIONS
	--====================================================

	DisableAnimations = true,

	-- Делает AnimationId нулевым при первоначальной обработке.
	SetAnimationIdsToZero = true,

	-- TRUE = удаляем Animator из модели после остановки.
	-- Это самый агрессивный вариант.
	DisableAnimator = true,

	-- Удалять Animate LocalScript из персонажей.
	DisableAnimateScript = true,

	--====================================================
	-- CHARACTER
	--====================================================

	RemoveAccessories = true,
	RemoveClothing = true,
	RemoveCharacterMeshes = false,

	SingleCharacterColor = true,

	--====================================================
	-- TOOLS
	--====================================================

	RemoveTools = false,

	--====================================================
	-- TERRAIN
	--====================================================

	SimplifyTerrain = true,

	--====================================================
	-- SCREEN
	--====================================================

	DarkenScreen = false,
	UseFog = false,

	--====================================================
	-- GUI
	--====================================================

	-- GUI не сканируется глобально.
	PixelateGuiImages = false,
	RemoveGuiImages = false,

	--====================================================
	-- MATERIAL
	--====================================================

	Material = Enum.Material.Plastic,

	--====================================================
	-- BATCH
	--====================================================

	-- Сколько объектов обрабатывать перед маленьким yield.
	-- Это влияет ТОЛЬКО на старт загрузки.
	ObjectsPerBatch = 150,

	-- Сколько частей персонажа менять за один batch.
	CharacterPartsPerBatch = 100,
}

--========================================================
-- SAFE
--========================================================

local function safe(fn)
	pcall(fn)
end

--========================================================
-- GRAPHICS QUALITY
-- Выполняется ОДИН РАЗ.
--========================================================

safe(function()
	local gameSettings = UserSettings():GetService("UserGameSettings")
	gameSettings.GraphicsQualityLevel = 1
end)

safe(function()
	settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
end)

--========================================================
-- LIGHTING
--========================================================

local function optimizeLighting()

	safe(function()
		Lighting.GlobalShadows = false
	end)

	safe(function()
		Lighting.EnvironmentDiffuseScale = 0
	end)

	safe(function()
		Lighting.EnvironmentSpecularScale = 0
	end)

	safe(function()
		Lighting.ShadowSoftness = 0
	end)

	safe(function()
		Lighting.Brightness = 1
	end)

	safe(function()
		Lighting.Technology = Enum.Technology.Compatibility
	end)

	-- Отключаем уже существующие эффекты.
	if CONFIG.DisablePostEffects then

		for _, obj in ipairs(Lighting:GetChildren()) do

			if obj:IsA("BloomEffect")
				or obj:IsA("BlurEffect")
				or obj:IsA("DepthOfFieldEffect")
				or obj:IsA("SunRaysEffect")
				or obj:IsA("ColorCorrectionEffect") then

				safe(function()
					obj.Enabled = false
				end)

			end
		end
	end

	if CONFIG.UseFog then

		safe(function()
			Lighting.FogColor = Color3.fromRGB(40, 40, 40)
			Lighting.FogStart = 80
			Lighting.FogEnd = 250
		end)

	end
end

optimizeLighting()

--========================================================
-- TERRAIN
--========================================================

local function optimizeTerrain()

	if not CONFIG.SimplifyTerrain then
		return
	end

	local terrain = Workspace:FindFirstChildOfClass("Terrain")

	if not terrain then
		return
	end

	safe(function()
		terrain.WaterWaveSize = 0
	end)

	safe(function()
		terrain.WaterWaveSpeed = 0
	end)

	safe(function()
		terrain.WaterReflectance = 0
	end)

	safe(function()
		terrain.WaterTransparency = 1
	end)
end

optimizeTerrain()

--========================================================
-- CHARACTER DETECTION
--========================================================

local function isCharacter(model)

	if not model or not model:IsA("Model") then
		return false
	end

	if model:FindFirstChildOfClass("Humanoid") then
		return true
	end

	if model:FindFirstChildOfClass("Animator", true) then
		return true
	end

	return false
end

--========================================================
-- GET CHARACTER COLOR
--========================================================

local function getCharacterColor(character)

	local torso =
		character:FindFirstChild("Torso")
		or character:FindFirstChild("UpperTorso")
		or character:FindFirstChild("LowerTorso")

	if torso and torso:IsA("BasePart") then
		return torso.Color
	end

	local root = character:FindFirstChild("HumanoidRootPart")

	if root and root:IsA("BasePart") then
		return root.Color
	end

	local head = character:FindFirstChild("Head")

	if head and head:IsA("BasePart") then
		return head.Color
	end

	return Color3.fromRGB(128, 128, 128)
end

--========================================================
-- STOP ANIMATIONS ONCE
--========================================================

local function disableAnimations(character)

	if not CONFIG.DisableAnimations then
		return
	end

	--====================================================
	-- Disable Animate script
	--====================================================

	if CONFIG.DisableAnimateScript then

		local animate =
			character:FindFirstChild("Animate")

		if animate and animate:IsA("LocalScript") then

			safe(function()
				animate:Destroy()
			end)

		end
	end

	--====================================================
	-- Process Animator + Animation
	--====================================================

	local descendants = character:GetDescendants()

	for i = 1, #descendants do

		local obj = descendants[i]

		if obj:IsA("Animator") then

			safe(function()

				local tracks = obj:GetPlayingAnimationTracks()

				for _, track in ipairs(tracks) do

					pcall(function()
						track:Stop(0)
					end)

				end
			end)

			-- Полностью убираем Animator.
			if CONFIG.DisableAnimator then

				safe(function()
					obj.Parent = nil
				end)

			end

		elseif obj:IsA("Animation") then

			if CONFIG.SetAnimationIdsToZero then

				safe(function()
					obj.AnimationId = "rbxassetid://0"
				end)

			end
		end
	end
end

--========================================================
-- REMOVE CHARACTER VISUALS
--========================================================

local function removeCharacterVisuals(character)

	for _, obj in ipairs(character:GetChildren()) do

		-- ACCESSORIES
		if CONFIG.RemoveAccessories
			and obj:IsA("Accessory") then

			safe(function()
				obj:Destroy()
			end)

		-- CLOTHING
		elseif CONFIG.RemoveClothing
			and (
				obj:IsA("Shirt")
				or obj:IsA("Pants")
				or obj:IsA("ShirtGraphic")
			) then

			safe(function()
				obj:Destroy()
			end)

		-- CHARACTER MESH
		elseif CONFIG.RemoveCharacterMeshes
			and obj:IsA("CharacterMesh") then

			safe(function()
				obj:Destroy()
			end)

		-- TOOLS
		elseif CONFIG.RemoveTools
			and obj:IsA("Tool") then

			safe(function()
				obj:Destroy()
			end)

		end
	end
end

--========================================================
-- CHARACTER COLOR
--========================================================

local function optimizeCharacterColor(character)

	if not CONFIG.SingleCharacterColor then
		return
	end

	local color = getCharacterColor(character)

	local parts = {}

	for _, obj in ipairs(character:GetDescendants()) do

		if obj:IsA("BasePart") then
			table.insert(parts, obj)
		end
	end

	-- Обрабатываем частями, чтобы старт не зависал.
	for i = 1, #parts do

		safe(function()
			parts[i].Color = color
		end)

		if i % CONFIG.CharacterPartsPerBatch == 0 then
			task.wait()
		end
	end

	-- BodyColors
	local bodyColors = character:FindFirstChildOfClass("BodyColors")

	if bodyColors then

		local brick = BrickColor.new(color)

		safe(function()
			bodyColors.HeadColor = brick
		end)

		safe(function()
			bodyColors.TorsoColor = brick
		end)

		safe(function()
			bodyColors.LeftArmColor = brick
		end)

		safe(function()
			bodyColors.RightArmColor = brick
		end)

		safe(function()
			bodyColors.LeftLegColor = brick
		end)

		safe(function()
			bodyColors.RightLegColor = brick
		end)
	end
end

--========================================================
-- CHARACTER OPTIMIZATION
--========================================================

local function optimizeCharacter(character)

	if not character then
		return
	end

	if not character:IsA("Model") then
		return
	end

	if not character.Parent then
		return
	end

	--====================================================
	-- VISUALS
	--====================================================

	removeCharacterVisuals(character)

	--====================================================
	-- ANIMATIONS
	--====================================================

	disableAnimations(character)

	--====================================================
	-- COLOR
	--====================================================

	optimizeCharacterColor(character)
end

--========================================================
-- OBJECT OPTIMIZATION
--========================================================

local function optimizeObject(obj)

	if not obj or not obj.Parent then
		return
	end

	--====================================================
	-- BASEPART
	--====================================================

	if obj:IsA("BasePart") then

		if CONFIG.RemoveShadows then

			safe(function()
				obj.CastShadow = false
			end)

		end

		if CONFIG.RemoveReflectance then

			safe(function()
				obj.Reflectance = 0
			end)

		end

		if CONFIG.SimplifyMaterials then

			safe(function()
				obj.Material = CONFIG.Material
			end)

		end
	end

	--====================================================
	-- MESHPART
	--====================================================

	if obj:IsA("MeshPart") then

		if CONFIG.RemoveTextures then

			safe(function()
				obj.TextureID = ""
			end)

		end

		safe(function()
			obj.RenderFidelity = Enum.RenderFidelity.Performance
		end)
	end

	--====================================================
	-- TEXTURES
	--====================================================

	if CONFIG.RemoveTextures then

		if obj:IsA("Decal")
			or obj:IsA("Texture") then

			safe(function()
				obj.Transparency = 1
			end)

		end
	end

	--====================================================
	-- SURFACE APPEARANCE
	--====================================================

	if CONFIG.RemoveSurfaceAppearance
		and obj:IsA("SurfaceAppearance") then

		safe(function()
			obj:Destroy()
		end)

		return
	end

	--====================================================
	-- PARTICLES
	--====================================================

	if CONFIG.DisableParticles then

		if obj:IsA("ParticleEmitter")
			or obj:IsA("Smoke")
			or obj:IsA("Fire")
			or obj:IsA("Sparkles") then

			safe(function()
				obj.Enabled = false
			end)

		end
	end

	--====================================================
	-- TRAILS
	--====================================================

	if CONFIG.DisableTrails
		and obj:IsA("Trail") then

		safe(function()
			obj.Enabled = false
		end)

	end

	--====================================================
	-- BEAMS
	--====================================================

	if CONFIG.DisableBeams
		and obj:IsA("Beam") then

		safe(function()
			obj.Enabled = false
		end)

	end

	--====================================================
	-- LIGHTS
	--====================================================

	if CONFIG.DisableLights then

		if obj:IsA("PointLight")
			or obj:IsA("SpotLight")
			or obj:IsA("SurfaceLight") then

			safe(function()
				obj.Enabled = false
			end)

		end
	end

	--====================================================
	-- POST EFFECTS
	--====================================================

	if CONFIG.DisablePostEffects then

		if obj:IsA("BloomEffect")
			or obj:IsA("BlurEffect")
			or obj:IsA("DepthOfFieldEffect")
			or obj:IsA("SunRaysEffect")
			or obj:IsA("ColorCorrectionEffect") then

			safe(function()
				obj.Enabled = false
			end)

		end
	end

	--====================================================
	-- VIDEO
	--====================================================

	if CONFIG.DisableVideo
		and obj:IsA("VideoFrame") then

		safe(function()
			obj.Playing = false
		end)

		safe(function()
			obj.Visible = false
		end)

	end
end

--========================================================
-- STARTUP WORLD OPTIMIZATION
--
-- ВАЖНО:
-- Только Workspace.
-- Никакого game:GetDescendants().
--========================================================

local function optimizeWorkspace()

	local objects = Workspace:GetDescendants()

	for i = 1, #objects do

		local obj = objects[i]

		if obj and obj.Parent then

			-- Если модель персонаж/NPC
			if obj:IsA("Model")
				and isCharacter(obj) then

				-- Обрабатываем персонажа здесь.
				optimizeCharacter(obj)

			else

				optimizeObject(obj)

			end
		end

		-- Маленький yield.
		-- Это происходит только во время стартовой обработки.
		if i % CONFIG.ObjectsPerBatch == 0 then
			task.wait()
		end
	end
end

