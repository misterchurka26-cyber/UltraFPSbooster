-- ULTRA FPS BOOST EXTREME v6
-- ZERO RUNTIME COST
-- NO HEARTBEAT
-- NO RENDERSTEPPED
-- NO DESCENDANTADDED
-- NO PERIODIC SCAN
--
-- ОПТИМИЗИРУЕТ УЖЕ ЗАГРУЖЕННЫЙ МИР ОДИН РАЗ.
--
-- После завершения:
--   CPU от этого скрипта практически 0
--   Нет постоянного сканирования Workspace
--   Нет обработки каждого нового streamed объекта
--   Нет RenderStepped / Heartbeat
--
-- Основное:
--   • Graphics Quality -> 1
--   • Compatibility lighting
--   • Global Shadows OFF
--   • Environment lighting OFF
--   • MaterialVariant OFF
--   • Mesh texture OFF
--   • SurfaceAppearance OFF
--   • Decal / Texture OFF
--   • Particles / Smoke / Fire / Sparkles OFF
--   • Trails / Beams OFF
--   • Lights OFF
--   • Shadows OFF
--   • Reflectance OFF
--   • Mesh RenderFidelity = Performance
--   • Character accessories/clothes OFF
--   • Character animations OFF
--
-- ВАЖНО:
-- После начального прохода НЕТ обработки новых объектов.
-- Это специально сделано для устранения микрофризов
-- при быстром движении / Streaming.
--========================================================


--========================================================
-- SERVICES
--========================================================

local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local MaterialService = game:GetService("MaterialService")
local UserSettings = game:GetService("UserSettings")
local TweenService = game:GetService("TweenService")


--========================================================
-- SAFE
--========================================================

local function safe(fn)
	pcall(fn)
end


--========================================================
-- GRAPHICS QUALITY
--========================================================

safe(function()

	local gameSettings =
		UserSettings():GetService("UserGameSettings")

	gameSettings.GraphicsQualityLevel = 1

end)


safe(function()

	settings().Rendering.QualityLevel =
		Enum.QualityLevel.Level01

end)


--========================================================
-- LIGHTING
--========================================================

safe(function()
	Lighting.GlobalShadows = false
end)

safe(function()
	Lighting.EnvironmentDiffuseScale = 0
end)

safe(function()
	Lighting.EnvironmentSpecularScale = 0
end)

safe(function()
	Lighting.ShadowSoftness = 0
end)

safe(function()
	Lighting.Brightness = 1
end)

safe(function()
	Lighting.Technology = Enum.Technology.Compatibility
end)


--========================================================
-- POST EFFECTS
--========================================================

for _, obj in ipairs(Lighting:GetChildren()) do

	if obj:IsA("PostEffect") then

		safe(function()
			obj.Enabled = false
		end)

	end

end


--========================================================
-- MATERIAL SERVICE
--========================================================

for _, obj in ipairs(MaterialService:GetChildren()) do

	if obj:IsA("MaterialVariant")
		or obj:IsA("TerrainDetail") then

		safe(function()
			obj:Destroy()
		end)

	end

end


--========================================================
-- TERRAIN
--========================================================

local terrain = Workspace:FindFirstChildOfClass("Terrain")

if terrain then

	safe(function()
		terrain.WaterWaveSize = 0
	end)

	safe(function()
		terrain.WaterWaveSpeed = 0
	end)

	safe(function()
		terrain.WaterReflectance = 0
	end)

	safe(function()
		terrain.WaterTransparency = 1
	end)

end


--========================================================
-- ANIMATION CLEANUP
--========================================================

local function cleanupAnimationObject(obj)

	if not obj or not obj.Parent then
		return
	end


	-- AnimationController

	if obj:IsA("AnimationController") then

		safe(function()
			obj:Destroy()
		end)

		return
	end


	-- Animator

	if obj:IsA("Animator") then

		safe(function()

			for _, track in ipairs(
				obj:GetPlayingAnimationTracks()
			) do

				pcall(function()
					track:Stop(0)
				end)

			end

		end)


		safe(function()
			obj:Destroy()
		end)

		return
	end


	-- Animation

	if obj:IsA("Animation") then

		safe(function()
			obj.AnimationId = "rbxassetid://0"
		end)

	end

end


--========================================================
-- CHARACTER CLEANUP
--========================================================

local function cleanupCharacter(character)

	if not character or not character.Parent then
		return
	end


	--====================================================
	-- CLOTHES / ACCESSORIES
	--====================================================

	for _, child in ipairs(character:GetChildren()) do

		if child:IsA("Accessory")
			or child:IsA("Shirt")
			or child:IsA("Pants")
			or child:IsA("ShirtGraphic") then

			safe(function()
				child:Destroy()
			end)

		end

	end


	--====================================================
	-- ANIMATE SCRIPT
	--====================================================

	local animate =
		character:FindFirstChild("Animate")

	if animate then

		safe(function()
			animate:Destroy()
		end)

	end


	--====================================================
	-- ANIMATION OBJECTS
	--====================================================

	for _, obj in ipairs(
		character:GetDescendants()
	) do

		if obj:IsA("AnimationController")
			or obj:IsA("Animator")
			or obj:IsA("Animation") then

			cleanupAnimationObject(obj)

		end

	end

end


--========================================================
-- OBJECT OPTIMIZATION
--========================================================

local function optimizeObject(obj)

	if not obj or not obj.Parent then
		return
	end


	--====================================================
	-- ANIMATION
	--====================================================

	if obj:IsA("AnimationController")
		or obj:IsA("Animator")
		or obj:IsA("Animation") then

		cleanupAnimationObject(obj)

		return
	end


	--====================================================
	-- SURFACE APPEARANCE
	--====================================================

	if obj:IsA("SurfaceAppearance") then

		safe(function()
			obj:Destroy()
		end)

		return
	end


	--====================================================
	-- MESHPART
	--====================================================

	if obj:IsA("MeshPart") then

		-- Remove texture

		safe(function()
			obj.TextureID = ""
		end)


		-- Remove material variant

		safe(function()
			obj.MaterialVariant = ""
		end)


		-- Lowest mesh rendering cost

		safe(function()
			obj.RenderFidelity =
				Enum.RenderFidelity.Performance
		end)


		-- Remove reflections

		safe(function()
			obj.Reflectance = 0
		end)


		-- Disable shadows

		safe(function()
			obj.CastShadow = false
		end)


		-- SmoothPlastic

		if obj.Material ~= Enum.Material.Neon then

			safe(function()
				obj.Material =
					Enum.Material.SmoothPlastic
			end)

		end


		return
	end


	--====================================================
	-- SPECIAL MESH
	--====================================================

	if obj:IsA("SpecialMesh") then

		safe(function()
			obj.TextureId = ""
		end)

		return
	end


	--====================================================
	-- BASEPART
	--====================================================

	if obj:IsA("BasePart") then

		safe(function()
			obj.MaterialVariant = ""
		end)


		safe(function()
			obj.CastShadow = false
		end)


		safe(function()
			obj.Reflectance = 0
		end)


		if obj.Material ~= Enum.Material.Neon then

			safe(function()
				obj.Material =
					Enum.Material.SmoothPlastic
			end)

		end


		return
	end


	--====================================================
	-- DECAL
	--====================================================

	if obj:IsA("Decal") then

		safe(function()
			obj.Transparency = 1
		end)

		return
	end


	--====================================================
	-- TEXTURE
	--====================================================

	if obj:IsA("Texture") then

		safe(function()
			obj.Transparency = 1
		end)

		return
	end


	--====================================================
	-- PARTICLES
	--====================================================

	if obj:IsA("ParticleEmitter")
		or obj:IsA("Smoke")
		or obj:IsA("Fire")
		or obj:IsA("Sparkles") then

		safe(function()
			obj.Enabled = false
		end)

		return
	end


	--====================================================
	-- TRAIL
	--====================================================

	if obj:IsA("Trail") then

		safe(function()
			obj.Enabled = false
		end)

		return
	end


	--====================================================
	-- BEAM
	--====================================================

	if obj:IsA("Beam") then

		safe(function()
			obj.Enabled = false
		end)

		return
	end


	--====================================================
	-- LIGHTS
	--====================================================

	if obj:IsA("PointLight")
		or obj:IsA("SpotLight")
		or obj:IsA("SurfaceLight") then

		safe(function()
			obj.Enabled = false
		end)

		return
	end


	--====================================================
	-- VIDEO
	--====================================================

	if obj:IsA("VideoFrame") then

		safe(function()
			obj.Playing = false
		end)

		safe(function()
			obj.Visible = false
		end)

		return
	end

end


--========================================================
-- INITIAL WORLD OPTIMIZATION
--========================================================

task.spawn(function()

	local objects = Workspace:GetDescendants()

	local total = #objects


	--====================================================
	-- WORLD
	--====================================================

	for i = 1, total do

		local obj = objects[i]

		if obj and obj.Parent then
			optimizeObject(obj)
		end


		-- Small batches.
		--
		-- Это уменьшает сильный startup freeze,
		-- но после завершения вообще ничего не работает.

		if i % 500 == 0 then
			task.wait()
		end

	end


	--====================================================
	-- CURRENT CHARACTERS / NPC
	--====================================================

	for _, obj in ipairs(objects) do

		if obj:IsA("Model") then

			if obj:FindFirstChildOfClass("Humanoid")
				or obj:FindFirstChildOfClass(
					"AnimationController",
					true
				)
				or obj:FindFirstChildOfClass(
					"Animator",
					true
				) then

				cleanupCharacter(obj)

			end

		end

	end


	print("============================================")
	print(" ULTRA FPS BOOST EXTREME v6")
	print(" INITIAL OPTIMIZATION COMPLETE")
	print("============================================")
	print(" Runtime scanning : OFF")
	print(" DescendantAdded   : OFF")
	print(" Heartbeat         : OFF")
	print(" RenderStepped     : OFF")
	print(" Periodic scan     : OFF")
	print(" Streaming handler : OFF")
	print("============================================")

end)


--========================================================
-- PLAYER CHARACTER
--========================================================

local function setupPlayer(player)

	if player.Character then

		task.defer(function()

			if player.Character then
				cleanupCharacter(player.Character)
			end

		end)

	end


	-- Единственный постоянный connection.
	-- Срабатывает только при респавне игрока.

	player.CharacterAdded:Connect(function(character)

		task.defer(function()

			if character and character.Parent then
				cleanupCharacter(character)
			end

		end)

	end)

end


--========================================================
-- EXISTING PLAYERS
--========================================================

for _, player in ipairs(Players:GetPlayers()) do
	setupPlayer(player)
end


--========================================================
-- NEW PLAYERS
--========================================================

Players.PlayerAdded:Connect(setupPlayer)


