--========================================================
-- VFX
--========================================================

local function removeVFX(obj)

	if obj:IsA("ParticleEmitter")
		or obj:IsA("Trail")
		or obj:IsA("Beam")
		or obj:IsA("Smoke")
		or obj:IsA("Fire")
		or obj:IsA("Sparkles")
		or obj:IsA("Highlight") then

		safe(function()
			obj:Destroy()
		end)

		return true
	end

	return false
end

--========================================================
-- ANIMATION
--========================================================

local function removeAnimation(obj)

	if obj:IsA("AnimationController") then

		safe(function()
			obj:Destroy()
		end)

		return true
	end

	if obj:IsA("Animator") then

		safe(function()

			for _, track in ipairs(
				obj:GetPlayingAnimationTracks()
			) do

				pcall(function()
					track:Stop(0)
				end)

			end

		end)

		safe(function()
			obj:Destroy()
		end)

		return true
	end

	if obj:IsA("Animation") then

		safe(function()
			obj.AnimationId = "rbxassetid://0"
		end)

		return true
	end

	return false
end

--========================================================
-- OBJECT OPTIMIZATION
--========================================================

local function optimizeObject(obj)

	if not obj or not obj.Parent then
		return
	end

	--====================================================
	-- ANIMATION
	--====================================================

	if removeAnimation(obj) then
		return
	end

	--====================================================
	-- VFX
	--====================================================

	if removeVFX(obj) then
		return
	end

	--====================================================
	-- SURFACE APPEARANCE
	--====================================================

	if obj:IsA("SurfaceAppearance") then

		safe(function()
			obj:Destroy()
		end)

		return
	end

	--====================================================
	-- SPECIAL MESH
	--====================================================

	if obj:IsA("SpecialMesh") then

		safe(function()
			obj.TextureId = ""
		end)

		return
	end

	--====================================================
	-- MESHPART
	--====================================================

	if obj:IsA("MeshPart") then

		-- Убрать текстуру
		safe(function()
			obj.TextureID = ""
		end)

		-- Убрать MaterialVariant
		safe(function()
			obj.MaterialVariant = ""
		end)

		-- Performance
		safe(function()
			obj.RenderFidelity = Enum.RenderFidelity.Performance
		end)

		-- Neon сохраняем
		if obj.Material ~= Enum.Material.Neon then

			safe(function()
				obj.Material = Enum.Material.SmoothPlastic
			end)

		end

		-- Shadows OFF
		safe(function()
			obj.CastShadow = false
		end)

		-- Reflectance OFF
		safe(function()
			obj.Reflectance = 0
		end)

		return
	end

	--====================================================
	-- BASEPART
	--====================================================

	if obj:IsA("BasePart") then

		safe(function()
			obj.MaterialVariant = ""
		end)

		if obj.Material ~= Enum.Material.Neon then

			safe(function()
				obj.Material = Enum.Material.SmoothPlastic
			end)

		end

		safe(function()
			obj.CastShadow = false
		end)

		safe(function()
			obj.Reflectance = 0
		end)

		return
	end

	--====================================================
	-- DECAL
	--====================================================

	if obj:IsA("Decal") then

		safe(function()
			obj.Transparency = 1
		end)

		return
	end

	--====================================================
	-- TEXTURE
	--====================================================

	if obj:IsA("Texture") then

		safe(function()
			obj.Transparency = 1
		end)

		return
	end

	--====================================================
	-- LIGHTS
	--====================================================

	if obj:IsA("PointLight")
		or obj:IsA("SpotLight")
		or obj:IsA("SurfaceLight") then

		safe(function()
			obj.Enabled = false
		end)

		return
	end

	--====================================================
	-- VIDEO
	--====================================================

	if obj:IsA("VideoFrame") then

		safe(function()
			obj.Playing = false
		end)

		safe(function()
			obj.Visible = false
		end)

		return
	end

end

--========================================================
-- CHARACTER
--========================================================

local function optimizeCharacter(character)

	if not character or not character.Parent then
		return
	end

	--====================================================
	-- ACCESSORIES / CLOTHING
	--====================================================

	for _, child in ipairs(character:GetChildren()) do

		if child:IsA("Accessory")
			or child:IsA("Shirt")
			or child:IsA("Pants")
			or child:IsA("ShirtGraphic") then

			safe(function()
				child:Destroy()
			end)

		end
	end

	--====================================================
	-- ANIMATE SCRIPT
	--====================================================

	local animate =
		character:FindFirstChild("Animate")

	if animate then

		safe(function()
			animate:Destroy()
		end)

	end

	--====================================================
	-- ALL CHARACTER OBJECTS
	--====================================================

	local descendants = character:GetDescendants()

	for i = 1, #descendants do

		local obj = descendants[i]

		if obj and obj.Parent then
			optimizeObject(obj)
		end

		if i % MAX_BATCH == 0 then
			task.wait()
		end
	end

end

--========================================================
-- ONE-TIME WORLD OPTIMIZATION
--========================================================

task.spawn(function()

	print("============================================")
	print(" Arcizz0 Booster")
	print(" Starting optimization...")
	print("============================================")

	-- Только Workspace.
	local objects = Workspace:GetDescendants()

	for i = 1, #objects do

		local obj = objects[i]

		if obj and obj.Parent then
			optimizeObject(obj)
		end

		if i % MAX_BATCH == 0 then
			task.wait()
		end

	end

	--====================================================
	-- EXISTING PLAYERS / NPC / BRAINROTS
	--====================================================

	for _, obj in ipairs(objects) do

		if obj:IsA("Model") then

			if obj:FindFirstChildOfClass("Humanoid")
				or obj:FindFirstChildOfClass(
					"AnimationController",
					true
				)
				or obj:FindFirstChildOfClass(
					"Animator",
					true
				) then

				task.spawn(function()

					if obj.Parent then
						optimizeCharacter(obj)
					end

				end)

			end
		end
	end

	print("============================================")
	print(" Arcizz0 Booster")
	print(" Optimization complete!")
	print(" Runtime optimizer: OFF")
	print("============================================")

end)

--========================================================
-- PLAYER RESPAWN ONLY
--
-- Это единственное постоянное событие.
-- Оно относится только к персонажу игрока.
--========================================================

local function setupPlayer(player)

	-- Текущий персонаж
	if player.Character then

		task.defer(function()

			if player.Character then
				optimizeCharacter(player.Character)
			end

		end)
	end

	-- Новый персонаж после смерти
	player.CharacterAdded:Connect(function(character)

		task.defer(function()

			if character and character.Parent then
				optimizeCharacter(character)
			end

		end)

	end)
end

for _, player in ipairs(Players:GetPlayers()) do
	setupPlayer(player)
end

Players.PlayerAdded:Connect(setupPlayer)

