--========================================================
-- ANIMATION
--========================================================

local function disableAnimationObject(obj)

	if obj:IsA("AnimationController") then

		safe(function()
			obj:Destroy()
		end)

		return
	end

	if obj:IsA("Animator") then

		pcall(function()

			for _, track in ipairs(obj:GetPlayingAnimationTracks()) do
				pcall(function()
					track:Stop(0)
				end)
			end

			obj:Destroy()
		end)

		return
	end

	if obj:IsA("Animation") then

		safe(function()
			obj.AnimationId = "rbxassetid://0"
		end)

	end
end

--========================================================
-- CHARACTER CLEANUP
--========================================================

local function cleanupCharacter(character)

	if not character or not character.Parent then
		return
	end

	-- Одежда / аксессуары
	for _, child in ipairs(character:GetChildren()) do

		if child:IsA("Accessory")
			or child:IsA("Shirt")
			or child:IsA("Pants")
			or child:IsA("ShirtGraphic") then

			safe(function()
				child:Destroy()
			end)

		end
	end

	-- Animate
	local animate = character:FindFirstChild("Animate")

	if animate then

		safe(function()
			animate:Destroy()
		end)

	end

	-- Анимационные объекты
	for _, obj in ipairs(character:GetDescendants()) do

		if obj:IsA("AnimationController")
			or obj:IsA("Animator")
			or obj:IsA("Animation") then

			disableAnimationObject(obj)

		end
	end
end

--========================================================
-- OBJECT OPTIMIZATION
--
-- ВАЖНО (фикс фризов #2): на каждый тип объекта теперь
-- ОДИН pcall со всеми свойствами внутри, вместо 5-8
-- отдельных pcall(function()...end) на каждое свойство.
-- Логика/результат — те же самые, просто меньше мусора
-- (замыканий) создаётся при каждой обработке объекта.
--========================================================

local function optimizeObject(obj)

	if not obj or not obj.Parent then
		return
	end

	--====================================================
	-- ANIMATION
	--====================================================

	if obj:IsA("AnimationController")
		or obj:IsA("Animator")
		or obj:IsA("Animation") then

		disableAnimationObject(obj)
		return
	end

	--====================================================
	-- SURFACE APPEARANCE
	--====================================================

	if obj:IsA("SurfaceAppearance") then

		pcall(function()
			obj:Destroy()
		end)

		return
	end

	--====================================================
	-- MESHPART
	--====================================================

	if obj:IsA("MeshPart") then

		pcall(function()

			-- Убираем legacy texture.
			obj.TextureID = ""

			-- Убираем MaterialVariant.
			obj.MaterialVariant = ""

			-- Самый дешёвый render fidelity.
			obj.RenderFidelity = Enum.RenderFidelity.Performance

			-- SmoothPlastic.
			-- Neon специально оставляем.
			if obj.Material ~= Enum.Material.Neon then
				obj.Material = Enum.Material.SmoothPlastic
			end

			-- Тени.
			obj.CastShadow = false

			-- Reflectance.
			obj.Reflectance = 0
		end)

		return
	end

	--====================================================
	-- SPECIALMESH
	--====================================================

	if obj:IsA("SpecialMesh") then

		pcall(function()
			obj.TextureId = ""
		end)

		return
	end

	--====================================================
	-- BASEPART
	--====================================================

	if obj:IsA("BasePart") then

		pcall(function()

			-- MaterialVariant выключаем.
			obj.MaterialVariant = ""

			-- Всё -> SmoothPlastic,
			-- кроме Neon.
			if obj.Material ~= Enum.Material.Neon then
				obj.Material = Enum.Material.SmoothPlastic
			end

			-- Тени.
			obj.CastShadow = false

			-- Отражения.
			obj.Reflectance = 0
		end)

		return
	end

	--====================================================
	-- DECAL
	--====================================================

	if obj:IsA("Decal") then

		pcall(function()
			obj.Transparency = 1
		end)

		return
	end

	--====================================================
	-- TEXTURE
	--====================================================

	if obj:IsA("Texture") then

		pcall(function()
			obj.Transparency = 1
		end)

		return
	end

	--====================================================
	-- PARTICLES
	--====================================================

	if obj:IsA("ParticleEmitter")
		or obj:IsA("Smoke")
		or obj:IsA("Fire")
		or obj:IsA("Sparkles") then

		pcall(function()
			obj.Enabled = false
		end)

		return
	end

	--====================================================
	-- TRAIL
	--====================================================

	if obj:IsA("Trail") then

		pcall(function()
			obj.Enabled = false
		end)

		return
	end

	--====================================================
	-- BEAM
	--====================================================

	if obj:IsA("Beam") then

		pcall(function()
			obj.Enabled = false
		end)

		return
	end

	--====================================================
	-- LIGHT
	--====================================================

	if obj:IsA("PointLight")
		or obj:IsA("SpotLight")
		or obj:IsA("SurfaceLight") then

		pcall(function()
			obj.Enabled = false
		end)

		return
	end

	--====================================================
	-- VIDEO
	--====================================================

	if obj:IsA("VideoFrame") then

		pcall(function()
			obj.Playing = false
			obj.Visible = false
		end)

		return
	end

end

--========================================================
-- STARTUP WORLD
--
-- Единственный массовый проход по уже существующим
-- объектам. Как и раньше — с task.wait() каждые
-- MAX_BATCH объектов, чтобы не фризить на самом старте.
--========================================================

task.spawn(function()

	local objects = Workspace:GetDescendants()

	for i = 1, #objects do

		local obj = objects[i]

		if obj and obj.Parent then
			optimizeObject(obj)
		end

		-- Только во время первоначальной загрузки.
		if i % MAX_BATCH == 0 then
			task.wait()
		end
	end

	--====================================================
	-- EXISTING CHARACTERS / NPC / BRAINROTS
	--====================================================

	for _, obj in ipairs(objects) do

		if obj:IsA("Model") then

			if obj:FindFirstChildOfClass("Humanoid")
				or obj:FindFirstChildOfClass("AnimationController", true)
				or obj:FindFirstChildOfClass("Animator", true) then

				cleanupCharacter(obj)

			end
		end
	end

	print("============================================")
	print(" ULTRA FPS BOOST EXTREME v6")
	print(" INITIAL CLEANUP COMPLETE")
	print("============================================")

end)

--========================================================
-- FUTURE OBJECTS (STREAMING-SAFE QUEUE)
--
-- ГЛАВНЫЙ ФИКС МИКРОФРИЗОВ.
--
-- Раньше: каждый новый объект обрабатывался мгновенно
-- внутри самого события DescendantAdded. Когда камера
-- крутится или персонаж быстро бежит, StreamingEnabled
-- может подгрузить сразу пачку объектов за один кадр —
-- раньше это означало пачку обработки (и пачку pcall)
-- в этом же кадре -> просадка/фриз.
--
-- Теперь: новый объект просто кладётся в очередь
-- (дешёвая операция). Разгрузка очереди идёт в одном
-- Heartbeat с тайм-бюджетом ~1.5ms за кадр. Если объектов
-- пришло много — они спокойно доедаются за следующие
-- несколько кадров, без единого рывка.
--
-- Если очередь пуста (99% времени) — Heartbeat выходит
-- почти без затрат, постоянной нагрузки это не создаёт.
--========================================================

local pendingQueue = {}
local pendingSet = {}
local queueHead = 1

local function enqueueObject(obj)

	if pendingSet[obj] then
		return
	end

	pendingSet[obj] = true
	pendingQueue[#pendingQueue + 1] = obj
end

RunService.Heartbeat:Connect(function()

	if queueHead > #pendingQueue then
		return
	end

	local startTime = os.clock()
	local processedThisFrame = 0

	while queueHead <= #pendingQueue do

		local obj = pendingQueue[queueHead]
		queueHead += 1

		if obj then
			pendingSet[obj] = nil

			if obj.Parent then
				optimizeObject(obj)
			end
		end

		processedThisFrame += 1

		if processedThisFrame >= MAX_PER_FRAME_HARD_CAP then
			break
		end

		if os.clock() - startTime >= FRAME_BUDGET_SECONDS then
			break
		end
	end

	-- Периодическая компакция очереди, чтобы таблица
	-- не росла бесконечно при долгой сессии.
	if queueHead > 2000 then

		local newQueue = table.create(#pendingQueue - queueHead + 1)

		for i = queueHead, #pendingQueue do
			newQueue[#newQueue + 1] = pendingQueue[i]
		end

		pendingQueue = newQueue
		queueHead = 1
	end
end)

Workspace.DescendantAdded:Connect(function(obj)

	if not obj then
		return
	end

	-- Самые важные новые визуальные объекты.
	if obj:IsA("MeshPart")
		or obj:IsA("SpecialMesh")
		or obj:IsA("SurfaceAppearance")
		or obj:IsA("Decal")
		or obj:IsA("Texture")
		or obj:IsA("MaterialVariant")
		or obj:IsA("ParticleEmitter")
		or obj:IsA("Smoke")
		or obj:IsA("Fire")
		or obj:IsA("Sparkles")
		or obj:IsA("Trail")
		or obj:IsA("Beam")
		or obj:IsA("PointLight")
		or obj:IsA("SpotLight")
		or obj:IsA("SurfaceLight")
		or obj:IsA("AnimationController")
		or obj:IsA("Animator")
		or obj:IsA("Animation")
		or obj:IsA("VideoFrame") then

		enqueueObject(obj)

	end
end)

