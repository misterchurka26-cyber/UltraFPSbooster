--
-- ЕСТЬ:
--   ✅ Одна стартовая оптимизация
--   ✅ ОДНО лёгкое событие Workspace.DescendantAdded
--   ✅ Реакция только на нужные типы
--   ✅ Удаление новых Animator / AnimationController
--   ✅ Удаление новых текстур MeshPart / SpecialMesh
--========================================================

local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local UserSettings = game:GetService("UserSettings")

--========================================================
-- CONFIG
--========================================================

local CONFIG = {

	--====================================================
	-- GRAPHICS
	--====================================================

	RemoveTextures = true,
	RemoveSurfaceAppearance = true,

	RemoveShadows = true,
	SimplifyMaterials = true,
	RemoveReflectance = true,

	DisableParticles = true,
	DisableTrails = true,
	DisableBeams = true,
	DisableLights = true,
	DisablePostEffects = true,
	DisableVideo = true,

	--====================================================
	-- ANIMATION
	--====================================================

	DisableAnimations = true,

	-- Ставить AnimationId в 0
	SetAnimationIdsToZero = true,

	-- Удалять Animator
	DisableAnimator = true,

	-- Удалять AnimationController
	DisableAnimationController = true,

	-- Удалять Animate LocalScript у игроков
	DisableAnimateScript = true,

	--====================================================
	-- CHARACTER
	--====================================================

	RemoveAccessories = true,
	RemoveClothing = true,
	RemoveCharacterMeshes = false,

	-- Включено только для уже существующих персонажей.
	-- Новые части специально не перекрашиваются глобальным
	-- проходом, чтобы не создавать CPU-spikes.
	SingleCharacterColor = true,

	--====================================================
	-- TOOLS
	--====================================================

	RemoveTools = false,

	--====================================================
	-- TERRAIN
	--====================================================

	SimplifyTerrain = true,

	--====================================================
	-- SCREEN
	--====================================================

	DarkenScreen = false,
	UseFog = false,

	--====================================================
	-- GUI
	--====================================================

	PixelateGuiImages = false,
	RemoveGuiImages = false,

	--====================================================
	-- MATERIAL
	--====================================================

	Material = Enum.Material.Plastic,

	--====================================================
	-- STARTUP
	--====================================================

	ObjectsPerBatch = 200,
	CharacterPartsPerBatch = 150,
}

--========================================================
-- SAFE
--========================================================

local function safe(fn)
	pcall(fn)
end

--========================================================
-- GRAPHICS QUALITY
--========================================================

safe(function()
	local gameSettings = UserSettings():GetService("UserGameSettings")
	gameSettings.GraphicsQualityLevel = 1
end)

safe(function()
	settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
end)

--========================================================
-- LIGHTING
--========================================================

local function optimizeLighting()

	safe(function()
		Lighting.GlobalShadows = false
	end)

	safe(function()
		Lighting.EnvironmentDiffuseScale = 0
	end)

	safe(function()
		Lighting.EnvironmentSpecularScale = 0
	end)

	safe(function()
		Lighting.ShadowSoftness = 0
	end)

	safe(function()
		Lighting.Brightness = 1
	end)

	safe(function()
		Lighting.Technology = Enum.Technology.Compatibility
	end)

	if CONFIG.DisablePostEffects then

		for _, obj in ipairs(Lighting:GetChildren()) do

			if obj:IsA("BloomEffect")
				or obj:IsA("BlurEffect")
				or obj:IsA("DepthOfFieldEffect")
				or obj:IsA("SunRaysEffect")
				or obj:IsA("ColorCorrectionEffect") then

				safe(function()
					obj.Enabled = false
				end)

			end
		end
	end

	if CONFIG.UseFog then

		safe(function()
			Lighting.FogColor = Color3.fromRGB(40, 40, 40)
			Lighting.FogStart = 80
			Lighting.FogEnd = 250
		end)

	end
end

optimizeLighting()

--========================================================
-- TERRAIN
--========================================================

local function optimizeTerrain()

	if not CONFIG.SimplifyTerrain then
		return
	end

	local terrain = Workspace:FindFirstChildOfClass("Terrain")

	if not terrain then
		return
	end

	safe(function()
		terrain.WaterWaveSize = 0
	end)

	safe(function()
		terrain.WaterWaveSpeed = 0
	end)

	safe(function()
		terrain.WaterReflectance = 0
	end)

	safe(function()
		terrain.WaterTransparency = 1
	end)
end

optimizeTerrain()

--========================================================
-- CHARACTER DETECTION
--========================================================

local function isCharacter(model)

	if not model or not model:IsA("Model") then
		return false
	end

	return model:FindFirstChildOfClass("Humanoid") ~= nil
		or model:FindFirstChildOfClass("Animator", true) ~= nil
end

--========================================================
-- CHARACTER COLOR
--========================================================

local function getCharacterColor(character)

	local torso =
		character:FindFirstChild("Torso")
		or character:FindFirstChild("UpperTorso")
		or character:FindFirstChild("LowerTorso")

	if torso and torso:IsA("BasePart") then
		return torso.Color
	end

	local root = character:FindFirstChild("HumanoidRootPart")

	if root and root:IsA("BasePart") then
		return root.Color
	end

	local head = character:FindFirstChild("Head")

	if head and head:IsA("BasePart") then
		return head.Color
	end

	return Color3.fromRGB(128, 128, 128)
end

--========================================================
-- REMOVE ANIMATION SYSTEM
--========================================================

local function disableAnimationObject(obj)

	if not CONFIG.DisableAnimations then
		return
	end

	--====================================================
	-- ANIMATION CONTROLLER
	--====================================================

	if CONFIG.DisableAnimationController
		and obj:IsA("AnimationController") then

		safe(function()
			obj:Destroy()
		end)

		return
	end

	--====================================================
	-- ANIMATOR
	--====================================================

	if obj:IsA("Animator") then

		-- Сначала пытаемся остановить уже играющие tracks.
		safe(function()

			for _, track in ipairs(obj:GetPlayingAnimationTracks()) do

				pcall(function()
					track:Stop(0)
				end)

			end

		end)

		-- Затем удаляем Animator.
		if CONFIG.DisableAnimator then

			safe(function()
				obj:Destroy()
			end)

		end

		return
	end

	--====================================================
	-- ANIMATION
	--====================================================

	if obj:IsA("Animation") then

		if CONFIG.SetAnimationIdsToZero then

			safe(function()
				obj.AnimationId = "rbxassetid://0"
			end)

		end

	end
end

--========================================================
-- REMOVE CHARACTER VISUALS
--========================================================

local function removeCharacterVisuals(character)

	for _, obj in ipairs(character:GetChildren()) do

		if CONFIG.RemoveAccessories
			and obj:IsA("Accessory") then

			safe(function()
				obj:Destroy()
			end)

		elseif CONFIG.RemoveClothing
			and (
				obj:IsA("Shirt")
				or obj:IsA("Pants")
				or obj:IsA("ShirtGraphic")
			) then

			safe(function()
				obj:Destroy()
			end)

		elseif CONFIG.RemoveCharacterMeshes
			and obj:IsA("CharacterMesh") then

			safe(function()
				obj:Destroy()
			end)

		elseif CONFIG.RemoveTools
			and obj:IsA("Tool") then

			safe(function()
				obj:Destroy()
			end)

		end
	end
end

--========================================================
-- CHARACTER COLOR
--========================================================

local function optimizeCharacterColor(character)

	if not CONFIG.SingleCharacterColor then
		return
	end

	local color = getCharacterColor(character)

	local parts = {}

	for _, obj in ipairs(character:GetDescendants()) do

		if obj:IsA("BasePart") then
			table.insert(parts, obj)
		end

	end

	for i = 1, #parts do

		safe(function()
			parts[i].Color = color
		end)

		if i % CONFIG.CharacterPartsPerBatch == 0 then
			task.wait()
		end

	end

	local bodyColors = character:FindFirstChildOfClass("BodyColors")

	if bodyColors then

		local brick = BrickColor.new(color)

		safe(function()
			bodyColors.HeadColor = brick
		end)

		safe(function()
			bodyColors.TorsoColor = brick
		end)

		safe(function()
			bodyColors.LeftArmColor = brick
		end)

		safe(function()
			bodyColors.RightArmColor = brick
		end)

		safe(function()
			bodyColors.LeftLegColor = brick
		end)

		safe(function()
			bodyColors.RightLegColor = brick
		end)

	end
end

--========================================================
-- EXISTING CHARACTER
--========================================================

local function optimizeCharacter(character)

	if not character then
		return
	end

	if not character:IsA("Model") then
		return
	end

	if not character.Parent then
		return
	end

	-- Одежда / аксессуары
	removeCharacterVisuals(character)

	-- Анимации
	if CONFIG.DisableAnimations then

		if CONFIG.DisableAnimateScript then

			local animate = character:FindFirstChild("Animate")

			if animate and animate:IsA("LocalScript") then

				safe(function()
					animate:Destroy()
				end)

			end
		end

		for _, obj in ipairs(character:GetDescendants()) do

			if obj:IsA("Animator")
				or obj:IsA("Animation")
				or obj:IsA("AnimationController") then

				disableAnimationObject(obj)

			end
		end
	end

	-- Цвет
	optimizeCharacterColor(character)
end

--========================================================
-- OBJECT OPTIMIZER
--
-- Эта функция вызывается:
-- 1. Во время стартовой обработки
-- 2. Только для конкретного нового объекта
--========================================================

local function optimizeObject(obj)

	if not obj or not obj.Parent then
		return
	end

	--====================================================
	-- ANIMATION
	--====================================================

	if obj:IsA("Animation")
		or obj:IsA("Animator")
		or obj:IsA("AnimationController") then

		disableAnimationObject(obj)

		if not obj.Parent then
			return
		end
	end

	--====================================================
	-- BASEPART
	--====================================================

	if obj:IsA("BasePart") then

		if CONFIG.RemoveShadows then

			safe(function()
				obj.CastShadow = false
			end)

		end

		if CONFIG.RemoveReflectance then

			safe(function()
				obj.Reflectance = 0
			end)

		end

		if CONFIG.SimplifyMaterials then

			safe(function()
				obj.Material = CONFIG.Material
			end)

		end
	end

	--====================================================
	-- MESHPART TEXTURE
	--====================================================

	if obj:IsA("MeshPart") then

		if CONFIG.RemoveTextures then

			safe(function()
				obj.TextureID = ""
			end)

		end

		safe(function()
			obj.RenderFidelity = Enum.RenderFidelity.Performance
		end)
	end

	--====================================================
	-- SPECIALMESH / FILEMESH
	--
	-- Именно здесь часто находятся текстуры крыльев,
	-- хвостов, волос, аксессуаров и т.п.
	--====================================================

	if CONFIG.RemoveTextures then

		if obj:IsA("SpecialMesh") then

			safe(function()
				obj.TextureId = ""
			end)

		end
	end

	--====================================================
	-- DECAL
	--====================================================

	if CONFIG.RemoveTextures
		and obj:IsA("Decal") then

		safe(function()
			obj.Transparency = 1
		end)

	end

	--====================================================
	-- TEXTURE
	--====================================================

	if CONFIG.RemoveTextures
		and obj:IsA("Texture") then

		safe(function()
			obj.Transparency = 1
		end)

	end

	--====================================================
	-- SURFACE APPEARANCE
	--====================================================

	if CONFIG.RemoveSurfaceAppearance
		and obj:IsA("SurfaceAppearance") then

		safe(function()
			obj:Destroy()
		end)

		return
	end

	--====================================================
	-- PARTICLES
	--====================================================

	if CONFIG.DisableParticles then

		if obj:IsA("ParticleEmitter")
			or obj:IsA("Smoke")
			or obj:IsA("Fire")
			or obj:IsA("Sparkles") then

			safe(function()
				obj.Enabled = false
			end)

		end
	end

	--====================================================
	-- TRAIL
	--====================================================

	if CONFIG.DisableTrails
		and obj:IsA("Trail") then

		safe(function()
			obj.Enabled = false
		end)

	end

	--====================================================
	-- BEAM
	--====================================================

	if CONFIG.DisableBeams
		and obj:IsA("Beam") then

		safe(function()
			obj.Enabled = false
		end)

	end

	--====================================================
	-- LIGHT
	--====================================================

	if CONFIG.DisableLights then

		if obj:IsA("PointLight")
			or obj:IsA("SpotLight")
			or obj:IsA("SurfaceLight") then

			safe(function()
				obj.Enabled = false
			end)

		end
	end

	--====================================================
	-- POST EFFECT
	--====================================================

	if CONFIG.DisablePostEffects then

		if obj:IsA("BloomEffect")
			or obj:IsA("BlurEffect")
			or obj:IsA("DepthOfFieldEffect")
			or obj:IsA("SunRaysEffect")
			or obj:IsA("ColorCorrectionEffect") then

			safe(function()
				obj.Enabled = false
			end)

		end
	end

	--====================================================
	-- VIDEO
	--====================================================

	if CONFIG.DisableVideo
		and obj:IsA("VideoFrame") then

		safe(function()
			obj.Playing = false
		end)

		safe(function()
			obj.Visible = false
		end)

	end

	--====================================================
	-- GUI
	--====================================================

	if CONFIG.PixelateGuiImages then

		if obj:IsA("ImageLabel")
			or obj:IsA("ImageButton") then

			safe(function()
				obj.ResampleMode = Enum.ResamplerMode.Pixelated
			end)

		end
	end

end

--========================================================
-- STARTUP WORLD
--========================================================

task.spawn(function()

	local objects = Workspace:GetDescendants()

	for i = 1, #objects do

		local obj = objects[i]

		if obj and obj.Parent then

			-- Сразу убираем AnimationController/Animator.
			if obj:IsA("AnimationController")
				or obj:IsA("Animator")
				or obj:IsA("Animation") then

				disableAnimationObject(obj)

			else

				optimizeObject(obj)

			end
		end

		if i % CONFIG.ObjectsPerBatch == 0 then
			task.wait()
		end
	end

	--====================================================
	-- Уже существующие Brainrots / NPC / Players
	--====================================================

	for _, obj in ipairs(Workspace:GetDescendants()) do

		if obj:IsA("Model") and isCharacter(obj) then

			task.spawn(function()

				if obj.Parent then
					optimizeCharacter(obj)
				end

			end)

		end
	end

	print("============================================")
	print(" ULTRA FPS BOOST v4")
	print(" INITIAL OPTIMIZATION FINISHED")
	print("============================================")

end)

--========================================================
-- FUTURE OBJECTS
--
-- ВАЖНО:
-- Это не цикл.
-- Это одно событие.
--
-- Мы НЕ проверяем всю игру.
-- Получаем только конкретно созданный объект.
--========================================================

Workspace.DescendantAdded:Connect(function(obj)

	if not obj then
		return
	end

	--====================================================
	-- ANIMATION SYSTEM
	--====================================================

	if obj:IsA("AnimationController")
		or obj:IsA("Animator")
		or obj:IsA("Animation") then

		-- Никаких task.wait.
		-- Никаких сканов.
		disableAnimationObject(obj)

		return
	end

	--====================================================
	-- VISUAL OBJECTS
	--====================================================

	if obj:IsA("MeshPart")
		or obj:IsA("SpecialMesh")
		or obj:IsA("SurfaceAppearance")
		or obj:IsA("Decal")
		or obj:IsA("Texture")
		or obj:IsA("ParticleEmitter")
		or obj:IsA("Smoke")
		or obj:IsA("Fire")
		or obj:IsA("Sparkles")
		or obj:IsA("Trail")
		or obj:IsA("Beam")
		or obj:IsA("PointLight")
		or obj:IsA("SpotLight")
		or obj:IsA("SurfaceLight")
		or obj:IsA("VideoFrame")
		or obj:IsA("BasePart") then

		-- Обрабатываем ТОЛЬКО этот объект.
		optimizeObject(obj)

		return
	end

	--====================================================
	-- ACCESSORY
	--====================================================

	if CONFIG.RemoveAccessories
		and obj:IsA("Accessory") then

		safe(function()
			obj:Destroy()
		end)

		return
	end

	--====================================================
	-- CLOTHING
	--====================================================

	if CONFIG.RemoveClothing then

		if obj:IsA("Shirt")
			or obj:IsA("Pants")
			or obj:IsA("ShirtGraphic") then

			safe(function()
				obj:Destroy()
			end)

			return
		end
	end

	--====================================================
	-- CHARACTER MESH
	--====================================================

	if CONFIG.RemoveCharacterMeshes
		and obj:IsA("CharacterMesh") then

		safe(function()
			obj:Destroy()
		end)

		return
	end

end)

--========================================================
-- PLAYER CHARACTERS
--
-- Только при респавне конкретного игрока.
--========================================================

local function setupPlayer(player)

	if not player then
		return
	end

	if player.Character then

		task.spawn(function()

			task.wait()

			if player.Character then
				optimizeCharacter(player.Character)
			end

		end)
	end

	player.CharacterAdded:Connect(function(character)

		task.spawn(function()

			task.wait()

			if character and character.Parent then
				optimizeCharacter(character)
			end

		end)

	end)
end

for _, player in ipairs(Players:GetPlayers()) do
	setupPlayer(player)
end

Players.PlayerAdded:Connect(setupPlayer)

