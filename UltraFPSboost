--========================================================
-- ULTRA FPS BOOST EXTREME v5
-- MAX FPS / NO LOOPS / NO HEARTBEAT
--
-- Делает:
--   • Все обычные детали -> SmoothPlastic
--   • Neon сохраняется
--   • MaterialVariant -> ""
--   • MaterialService MaterialVariant -> удаляется
--   • MeshPart TextureID -> ""
--   • SpecialMesh TextureId -> ""
--   • SurfaceAppearance -> удаляется
--   • Decal / Texture -> скрываются
--   • Тени -> OFF
--   • Reflectance -> 0
--   • Частицы/свет/лучи/трейлы -> OFF
--   • AnimationController -> удаляется
--   • Animator -> удаляется
--   • Animation -> AnimationId 0
--
-- После начальной обработки НЕТ циклов.
--========================================================

local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local MaterialService = game:GetService("MaterialService")
local UserSettings = game:GetService("UserSettings")




--========================================================
-- ARCIZZ0 BOOSTER INTRO GUI
-- ZERO LOOP / ZERO HEARTBEAT / ZERO RENDERSTEPPED
--========================================================

local TweenService = game:GetService("TweenService")

local function CreateBoosterGui()

	-- Не создавать второй раз
	local playerGui = Players.LocalPlayer:FindFirstChildOfClass("PlayerGui")
	if not playerGui then
		return
	end

	if playerGui:FindFirstChild("Arcizz0Booster") then
		return
	end

	--====================================================
	-- SCREEN GUI
	--====================================================

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "Arcizz0Booster"
	screenGui.ResetOnSpawn = false
	screenGui.IgnoreGuiInset = true
	screenGui.DisplayOrder = 999999
	screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	screenGui.Parent = playerGui

	--====================================================
	-- MAIN FRAME
	--====================================================

	local frame = Instance.new("Frame")
	frame.Name = "BoosterFrame"

	frame.AnchorPoint = Vector2.new(0.5, 0)

	-- Начинает полностью выше экрана
	frame.Position = UDim2.new(0.5, 0, 0, -95)

	frame.Size = UDim2.new(0, 390, 0, 70)

	frame.BackgroundColor3 = Color3.fromRGB(12, 2, 2)
	frame.BorderSizePixel = 0

	frame.ZIndex = 10
	frame.Parent = screenGui

	--====================================================
	-- CORNER
	--====================================================

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 13)
	corner.Parent = frame

	--====================================================
	-- STROKE
	--====================================================

	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Transparency = 0.15
	stroke.Color = Color3.fromRGB(125, 0, 0)
	stroke.Parent = frame

	--====================================================
	-- TOP RED LINE
	--====================================================

	local topLine = Instance.new("Frame")
	topLine.Name = "TopLine"

	topLine.Position = UDim2.new(0, 0, 0, 0)
	topLine.Size = UDim2.new(1, 0, 0, 3)

	topLine.BackgroundColor3 = Color3.fromRGB(180, 0, 0)
	topLine.BorderSizePixel = 0

	topLine.ZIndex = 11
	topLine.Parent = frame

	local topCorner = Instance.new("UICorner")
	topCorner.CornerRadius = UDim.new(0, 3)
	topCorner.Parent = topLine

	--====================================================
	-- TITLE
	--====================================================

	local title = Instance.new("TextLabel")
	title.Name = "Title"

	title.AnchorPoint = Vector2.new(0.5, 0.5)
	title.Position = UDim2.new(0.5, 0, 0.5, 0)

	title.Size = UDim2.new(1, -30, 1, -10)

	title.BackgroundTransparency = 1

	title.Text = "Arcizz0 Booster"
	title.Font = Enum.Font.GothamBold
	title.TextSize = 27

	title.TextXAlignment = Enum.TextXAlignment.Center
	title.TextYAlignment = Enum.TextYAlignment.Center

	title.TextColor3 = Color3.fromRGB(255, 0, 0)

	title.ZIndex = 12
	title.Parent = frame

	--====================================================
	-- TEXT GRADIENT
	--====================================================

	local gradient = Instance.new("UIGradient")
	gradient.Name = "RedGradient"

	gradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(70, 0, 0)),
		ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 25, 25)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(100, 0, 0)),
		ColorSequenceKeypoint.new(0.75, Color3.fromRGB(255, 0, 0)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(65, 0, 0)),
	})

	gradient.Offset = Vector2.new(-1, 0)
	gradient.Parent = title

	--====================================================
	-- OPEN TWEEN
	--====================================================

	local openTween = TweenService:Create(
		frame,
		TweenInfo.new(
			0.65,
			Enum.EasingStyle.Quint,
			Enum.EasingDirection.Out
		),
		{
			Position = UDim2.new(0.5, 0, 0, 18)
		}
	)

	--====================================================
	-- TEXT SHINE TWEENS
	--
	-- Без RenderStepped.
	-- TweenService работает на стороне Roblox.
	--====================================================

	local shine1 = TweenService:Create(
		gradient,
		TweenInfo.new(
			0.8,
			Enum.EasingStyle.Linear,
			Enum.EasingDirection.InOut
		),
		{
			Offset = Vector2.new(1, 0)
		}
	)

	local shine2 = TweenService:Create(
		gradient,
		TweenInfo.new(
			0.8,
			Enum.EasingStyle.Linear,
			Enum.EasingDirection.InOut
		),
		{
			Offset = Vector2.new(-1, 0)
		}
	)

	local shine3 = TweenService:Create(
		gradient,
		TweenInfo.new(
			0.8,
			Enum.EasingStyle.Linear,
			Enum.EasingDirection.InOut
		),
		{
			Offset = Vector2.new(1, 0)
		}
	)

	--====================================================
	-- CLOSE TWEEN
	--====================================================

	local closeTween = TweenService:Create(
		frame,
		TweenInfo.new(
			0.5,
			Enum.EasingStyle.Quint,
			Enum.EasingDirection.In
		),
		{
			Position = UDim2.new(0.5, 0, 0, -95)
		}
	)

	--====================================================
	-- SHOW
	--====================================================

	openTween:Play()
	shine1:Play()

	shine1.Completed:Connect(function()
		shine2:Play()
	end)

	shine2.Completed:Connect(function()
		shine3:Play()
	end)

	--====================================================
	-- WAIT 3 SECONDS
	--====================================================

	task.delay(3, function()

		-- Если GUI уже удалили
		if not screenGui.Parent then
			return
		end

		-- Останавливаем возможное переливание
		shine1:Cancel()
		shine2:Cancel()
		shine3:Cancel()

		-- Уезжаем наверх
		closeTween:Play()

		closeTween.Completed:Connect(function()

			if screenGui then
				screenGui:Destroy()
			end

		end)

	end)
end

--========================================================
-- FIRST EXECUTION
--========================================================

task.defer(CreateBoosterGui)

--========================================================
-- CONFIG
--========================================================

local MAX_BATCH = 300

--========================================================
-- SAFE
--========================================================

local function safe(fn)
	pcall(fn)
end

--========================================================
-- GRAPHICS QUALITY
--========================================================

safe(function()
	local settingsObject =
		UserSettings():GetService("UserGameSettings")

	settingsObject.GraphicsQualityLevel = 1
end)

safe(function()
	settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
end)

--========================================================
-- LIGHTING
--========================================================

safe(function()
	Lighting.GlobalShadows = false
end)

safe(function()
	Lighting.EnvironmentDiffuseScale = 0
end)

safe(function()
	Lighting.EnvironmentSpecularScale = 0
end)

safe(function()
	Lighting.ShadowSoftness = 0
end)

safe(function()
	Lighting.Brightness = 1
end)

safe(function()
	Lighting.Technology = Enum.Technology.Compatibility
end)

-- Убираем уже существующие post effects.
for _, obj in ipairs(Lighting:GetChildren()) do
	if obj:IsA("PostEffect") then
		safe(function()
			obj.Enabled = false
		end)
	end
end

--========================================================
-- MATERIALSERVICE
--
-- MaterialVariant может содержать ColorMap,
-- NormalMap, RoughnessMap, MetalnessMap и т.д.
--========================================================

for _, obj in ipairs(MaterialService:GetChildren()) do
	if obj:IsA("MaterialVariant") then

		safe(function()
			obj:Destroy()
		end)

	elseif obj:IsA("TerrainDetail") then

		safe(function()
			obj:Destroy()
		end)

	end
end

--========================================================
-- TERRAIN
--========================================================

local terrain = Workspace:FindFirstChildOfClass("Terrain")

if terrain then

	safe(function()
		terrain.WaterWaveSize = 0
	end)

	safe(function()
		terrain.WaterWaveSpeed = 0
	end)

	safe(function()
		terrain.WaterReflectance = 0
	end)

	safe(function()
		terrain.WaterTransparency = 1
	end)

end

--========================================================
-- ANIMATION
--========================================================

local function disableAnimationObject(obj)

	if obj:IsA("AnimationController") then

		safe(function()
			obj:Destroy()
		end)

		return
	end

	if obj:IsA("Animator") then

		safe(function()

			for _, track in ipairs(obj:GetPlayingAnimationTracks()) do

				pcall(function()
					track:Stop(0)
				end)

			end

		end)

		safe(function()
			obj:Destroy()
		end)

		return
	end

	if obj:IsA("Animation") then

		safe(function()
			obj.AnimationId = "rbxassetid://0"
		end)

	end
end

--========================================================
-- CHARACTER CLEANUP
--========================================================

local function cleanupCharacter(character)

	if not character or not character.Parent then
		return
	end

	-- Одежда / аксессуары
	for _, child in ipairs(character:GetChildren()) do

		if child:IsA("Accessory")
			or child:IsA("Shirt")
			or child:IsA("Pants")
			or child:IsA("ShirtGraphic") then

			safe(function()
				child:Destroy()
			end)

		end
	end

	-- Animate
	local animate = character:FindFirstChild("Animate")

	if animate then

		safe(function()
			animate:Destroy()
		end)

	end

	-- Анимационные объекты
	for _, obj in ipairs(character:GetDescendants()) do

		if obj:IsA("AnimationController")
			or obj:IsA("Animator")
			or obj:IsA("Animation") then

			disableAnimationObject(obj)

		end
	end
end

--========================================================
-- OBJECT OPTIMIZATION
--========================================================

local function optimizeObject(obj)

	if not obj or not obj.Parent then
		return
	end

	--====================================================
	-- ANIMATION
	--====================================================

	if obj:IsA("AnimationController")
		or obj:IsA("Animator")
		or obj:IsA("Animation") then

		disableAnimationObject(obj)
		return
	end

	--====================================================
	-- SURFACE APPEARANCE
	--====================================================

	if obj:IsA("SurfaceAppearance") then

		safe(function()
			obj:Destroy()
		end)

		return
	end

	--====================================================
	-- MESHPART
	--====================================================

	if obj:IsA("MeshPart") then

		-- Убираем legacy texture.
		safe(function()
			obj.TextureID = ""
		end)

		-- Убираем MaterialVariant.
		safe(function()
			obj.MaterialVariant = ""
		end)

		-- Самый дешёвый render fidelity.
		safe(function()
			obj.RenderFidelity = Enum.RenderFidelity.Performance
		end)

		-- SmoothPlastic.
		-- Neon специально оставляем.
		if obj.Material ~= Enum.Material.Neon then

			safe(function()
				obj.Material = Enum.Material.SmoothPlastic
			end)

		end

		-- Тени.
		safe(function()
			obj.CastShadow = false
		end)

		-- Reflectance.
		safe(function()
			obj.Reflectance = 0
		end)

		return
	end

	--====================================================
	-- SPECIALMESH
	--====================================================

	if obj:IsA("SpecialMesh") then

		safe(function()
			obj.TextureId = ""
		end)

		return
	end

	--====================================================
	-- BASEPART
	--====================================================

	if obj:IsA("BasePart") then

		-- MaterialVariant выключаем.
		safe(function()
			obj.MaterialVariant = ""
		end)

		-- Всё -> SmoothPlastic,
		-- кроме Neon.
		if obj.Material ~= Enum.Material.Neon then

			safe(function()
				obj.Material = Enum.Material.SmoothPlastic
			end)

		end

		-- Тени.
		safe(function()
			obj.CastShadow = false
		end)

		-- Отражения.
		safe(function()
			obj.Reflectance = 0
		end)

		return
	end

	--====================================================
	-- DECAL
	--====================================================

	if obj:IsA("Decal") then

		safe(function()
			obj.Transparency = 1
		end)

		return
	end

	--====================================================
	-- TEXTURE
	--====================================================

	if obj:IsA("Texture") then

		safe(function()
			obj.Transparency = 1
		end)

		return
	end

	--====================================================
	-- PARTICLES
	--====================================================

	if obj:IsA("ParticleEmitter")
		or obj:IsA("Smoke")
		or obj:IsA("Fire")
		or obj:IsA("Sparkles") then

		safe(function()
			obj.Enabled = false
		end)

		return
	end

	--====================================================
	-- TRAIL
	--====================================================

	if obj:IsA("Trail") then

		safe(function()
			obj.Enabled = false
		end)

		return
	end

	--====================================================
	-- BEAM
	--====================================================

	if obj:IsA("Beam") then

		safe(function()
			obj.Enabled = false
		end)

		return
	end

	--====================================================
	-- LIGHT
	--====================================================

	if obj:IsA("PointLight")
		or obj:IsA("SpotLight")
		or obj:IsA("SurfaceLight") then

		safe(function()
			obj.Enabled = false
		end)

		return
	end

	--====================================================
	-- VIDEO
	--====================================================

	if obj:IsA("VideoFrame") then

		safe(function()
			obj.Playing = false
		end)

		safe(function()
			obj.Visible = false
		end)

		return
	end

end

--========================================================
-- STARTUP WORLD
--
-- Единственный массовый проход.
--========================================================

task.spawn(function()

	local objects = Workspace:GetDescendants()

	for i = 1, #objects do

		local obj = objects[i]

		if obj and obj.Parent then
			optimizeObject(obj)
		end

		-- Только во время первоначальной загрузки.
		if i % MAX_BATCH == 0 then
			task.wait()
		end
	end

	--====================================================
	-- EXISTING CHARACTERS / NPC / BRAINROTS
	--====================================================

	for _, obj in ipairs(objects) do

		if obj:IsA("Model") then

			if obj:FindFirstChildOfClass("Humanoid")
				or obj:FindFirstChildOfClass("AnimationController", true)
				or obj:FindFirstChildOfClass("Animator", true) then

				cleanupCharacter(obj)

			end
		end
	end

	print("============================================")
	print(" ULTRA FPS BOOST EXTREME v5")
	print(" INITIAL CLEANUP COMPLETE")
	print("============================================")

end)

--========================================================
-- FUTURE OBJECTS
--
-- Единственная постоянная подписка.
--
-- Она НЕ сканирует Workspace.
-- Она получает только конкретно созданный объект.
--
-- Обрабатываются только объекты, которые реально могут
-- влиять на визуал.
--========================================================

Workspace.DescendantAdded:Connect(function(obj)

	if not obj then
		return
	end

	-- Самые важные новые визуальные объекты.
	if obj:IsA("MeshPart")
		or obj:IsA("SpecialMesh")
		or obj:IsA("SurfaceAppearance")
		or obj:IsA("Decal")
		or obj:IsA("Texture")
		or obj:IsA("MaterialVariant")
		or obj:IsA("ParticleEmitter")
		or obj:IsA("Smoke")
		or obj:IsA("Fire")
		or obj:IsA("Sparkles")
		or obj:IsA("Trail")
		or obj:IsA("Beam")
		or obj:IsA("PointLight")
		or obj:IsA("SpotLight")
		or obj:IsA("SurfaceLight")
		or obj:IsA("AnimationController")
		or obj:IsA("Animator")
		or obj:IsA("Animation")
		or obj:IsA("VideoFrame") then

		optimizeObject(obj)

	end
end)

--========================================================
-- PLAYER SPAWN
--
-- Только при появлении нового персонажа.
--========================================================

local function setupPlayer(player)

	if player.Character then

		task.defer(function()

			if player.Character then
				cleanupCharacter(player.Character)
			end

		end)

	end

	player.CharacterAdded:Connect(function(character)

		task.defer(function()

			if character and character.Parent then
				cleanupCharacter(character)
			end

		end)

	end)
end

for _, player in ipairs(Players:GetPlayers()) do
	setupPlayer(player)
end

Players.PlayerAdded:Connect(setupPlayer)

