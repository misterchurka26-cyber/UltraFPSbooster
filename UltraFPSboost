--========================================================
-- ULTRA FPS BOOST EXTREME v7
-- HARDCORE CLIENT OPTIMIZER
--
-- ЦЕЛЬ:
--   МАКСИМАЛЬНО СНИЗИТЬ GPU / CPU / PHYSICS НАГРУЗКУ
--
-- ВАЖНО:
--   НЕТ Heartbeat
--   НЕТ RenderStepped
--   НЕТ Stepped
--   НЕТ DescendantAdded
--   НЕТ периодических циклов
--   НЕТ постоянного сканирования
--
-- ОПТИМИЗАЦИЯ ПРОИСХОДИТ ОДИН РАЗ.
--
-- РЕКОМЕНДУЕТСЯ:
--   Workspace.StreamingEnabled = OFF
--   в Studio
--
--========================================================


--========================================================
-- SERVICES
--========================================================

local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local MaterialService = game:GetService("MaterialService")
local UserSettings = game:GetService("UserSettings")


--========================================================
-- SAFE
--========================================================

local function safe(fn)
	pcall(fn)
end


--========================================================
-- GRAPHICS QUALITY
--========================================================

safe(function()

	local gameSettings =
		UserSettings():GetService("UserGameSettings")

	gameSettings.GraphicsQualityLevel = 1

end)


safe(function()

	settings().Rendering.QualityLevel =
		Enum.QualityLevel.Level01

end)


--========================================================
-- LIGHTING
--========================================================

safe(function()
	Lighting.GlobalShadows = false
end)

safe(function()
	Lighting.EnvironmentDiffuseScale = 0
end)

safe(function()
	Lighting.EnvironmentSpecularScale = 0
end)

safe(function()
	Lighting.ShadowSoftness = 0
end)

safe(function()
	Lighting.Brightness = 1
end)

safe(function()
	Lighting.Technology = Enum.Technology.Compatibility
end)


--========================================================
-- DISABLE POST EFFECTS
--========================================================

for _, obj in ipairs(Lighting:GetChildren()) do

	if obj:IsA("PostEffect") then

		safe(function()
			obj.Enabled = false
		end)

	end

end


--========================================================
-- MATERIAL SERVICE
--========================================================

for _, obj in ipairs(MaterialService:GetChildren()) do

	if obj:IsA("MaterialVariant")
		or obj:IsA("TerrainDetail") then

		safe(function()
			obj:Destroy()
		end)

	end

end


--========================================================
-- TERRAIN
--========================================================

local terrain =
	Workspace:FindFirstChildOfClass("Terrain")

if terrain then

	safe(function()
		terrain.WaterWaveSize = 0
	end)

	safe(function()
		terrain.WaterWaveSpeed = 0
	end)

	safe(function()
		terrain.WaterReflectance = 0
	end)

	safe(function()
		terrain.WaterTransparency = 1
	end)

end


--========================================================
-- OBJECT OPTIMIZER
--========================================================

local function optimize(obj)

	if not obj or not obj.Parent then
		return
	end


	--====================================================
	-- SURFACE APPEARANCE
	--====================================================

	if obj:IsA("SurfaceAppearance") then

		safe(function()
			obj:Destroy()
		end)

		return
	end


	--====================================================
	-- MESHPART
	--====================================================

	if obj:IsA("MeshPart") then

		-- Убираем текстуру

		safe(function()
			obj.TextureID = ""
		end)


		-- Убираем MaterialVariant

		safe(function()
			obj.MaterialVariant = ""
		end)


		-- ЖЁСТКИЙ режим fidelity

		safe(function()
			obj.RenderFidelity =
				Enum.RenderFidelity.Performance
		end)


		-- Не рендерить обратные стороны,
		-- если объект их не требует

		safe(function()
			obj.DoubleSided = false
		end)


		-- Тени полностью OFF

		safe(function()
			obj.CastShadow = false
		end)


		-- Отражения OFF

		safe(function()
			obj.Reflectance = 0
		end)


		-- Самый дешёвый материал

		if obj.Material ~= Enum.Material.Neon then

			safe(function()
				obj.Material =
					Enum.Material.SmoothPlastic
			end)

		end


		--------------------------------------------------
		-- PHYSICS
		--
		-- Агрессивно уменьшаем физическую нагрузку.
		--
		-- CanQuery = false
		-- CanTouch = false
		--
		-- CanCollide НЕ выключаем,
		-- чтобы не ломать карту.
		--------------------------------------------------

		safe(function()
			obj.CanTouch = false
		end)

		safe(function()
			obj.CanQuery = false
		end)


		return
	end


	--====================================================
	-- SPECIAL MESH
	--====================================================

	if obj:IsA("SpecialMesh") then

		safe(function()
			obj.TextureId = ""
		end)

		return
	end


	--====================================================
	-- BASEPART
	--====================================================

	if obj:IsA("BasePart") then

		-- MaterialVariant OFF

		safe(function()
			obj.MaterialVariant = ""
		end)


		-- Shadows OFF

		safe(function()
			obj.CastShadow = false
		end)


		-- Reflectance OFF

		safe(function()
			obj.Reflectance = 0
		end)


		-- Query OFF

		safe(function()
			obj.CanQuery = false
		end)


		-- Touch OFF

		safe(function()
			obj.CanTouch = false
		end)


		-- SmoothPlastic

		if obj.Material ~= Enum.Material.Neon then

			safe(function()
				obj.Material =
					Enum.Material.SmoothPlastic
			end)

		end


		return
	end


	--====================================================
	-- DECAL
	--====================================================

	if obj:IsA("Decal") then

		safe(function()
			obj.Transparency = 1
		end)

		return
	end


	--====================================================
	-- TEXTURE
	--====================================================

	if obj:IsA("Texture") then

		safe(function()
			obj.Transparency = 1
		end)

		return
	end


	--====================================================
	-- PARTICLES
	--====================================================

	if obj:IsA("ParticleEmitter")
		or obj:IsA("Smoke")
		or obj:IsA("Fire")
		or obj:IsA("Sparkles") then

		safe(function()
			obj.Enabled = false
		end)

		return
	end


	--====================================================
	-- TRAILS
	--====================================================

	if obj:IsA("Trail") then

		safe(function()
			obj.Enabled = false
		end)

		return
	end


	--====================================================
	-- BEAMS
	--====================================================

	if obj:IsA("Beam") then

		safe(function()
			obj.Enabled = false
		end)

		return
	end


	--====================================================
	-- LIGHTS
	--====================================================

	if obj:IsA("PointLight")
		or obj:IsA("SpotLight")
		or obj:IsA("SurfaceLight") then

		safe(function()
			obj.Enabled = false
		end)

		return
	end


	--====================================================
	-- VIDEO
	--====================================================

	if obj:IsA("VideoFrame") then

		safe(function()
			obj.Playing = false
		end)

		safe(function()
			obj.Visible = false
		end)

		return
	end


	--====================================================
	-- ANIMATION
	--====================================================

	if obj:IsA("Animation") then

		safe(function()
			obj.AnimationId = "rbxassetid://0"
		end)

		return
	end


	--====================================================
	-- ANIMATOR
	--====================================================

	if obj:IsA("Animator") then

		safe(function()

			for _, track in ipairs(
				obj:GetPlayingAnimationTracks()
			) do

				pcall(function()
					track:Stop(0)
				end)

			end

		end)


		safe(function()
			obj:Destroy()
		end)

		return
	end


	--====================================================
	-- ANIMATION CONTROLLER
	--====================================================

	if obj:IsA("AnimationController") then

		safe(function()
			obj:Destroy()
		end)

		return
	end

end


--========================================================
-- ONE-TIME WORLD SCAN
--========================================================

task.spawn(function()

	local objects =
		Workspace:GetDescendants()

	--====================================================
	-- PASS 1
	--====================================================

	for i = 1, #objects do

		local obj = objects[i]

		if obj and obj.Parent then
			optimize(obj)
		end


		-- Очень большие пачки:
		-- меньше переключений task,
		-- выше startup скорость.

		if i % 1500 == 0 then
			task.wait()
		end

	end


	--====================================================
	-- CHARACTER CLEANUP
	--====================================================

	for _, player in ipairs(
		Players:GetPlayers()
	) do

		local character =
			player.Character

		if character then

			for _, obj in ipairs(
				character:GetDescendants()
			) do

				-- ACCESSORIES

				if obj:IsA("Accessory") then

					safe(function()
						obj:Destroy()
					end)

				end


				-- CLOTHES

				if obj:IsA("Shirt")
					or obj:IsA("Pants")
					or obj:IsA("ShirtGraphic") then

					safe(function()
						obj:Destroy()
					end)

				end

			end


			-- Animate

			local animate =
				character:FindFirstChild("Animate")

			if animate then

				safe(function()
					animate:Destroy()
				end)

			end

		end

	end


	--====================================================
	-- TERRAIN DECORATION
	--
	-- Свойство нельзя менять из обычного runtime
	-- скрипта, поэтому здесь специально НЕ пытаемся
	-- делать бесполезную запись.
	--====================================================


	--====================================================
	-- COMPLETE
	--====================================================

	print("==============================================")
	print(" ULTRA FPS BOOST EXTREME v7")
	print(" HARDCORE OPTIMIZATION COMPLETE")
	print("==============================================")
	print(" Graphics Quality : 1")
	print(" Lighting          : Compatibility")
	print(" Global Shadows    : OFF")
	print(" Post Effects      : OFF")
	print(" MaterialVariants  : OFF")
	print(" Mesh Textures     : OFF")
	print(" SurfaceAppearance : OFF")
	print(" RenderFidelity    : Performance")
	print(" DoubleSided       : OFF")
	print(" CastShadow        : OFF")
	print(" Reflectance       : OFF")
	print(" CanTouch          : OFF")
	print(" CanQuery          : OFF")
	print(" Decals            : OFF")
	print(" Textures          : OFF")
	print(" Particles         : OFF")
	print(" Smoke             : OFF")
	print(" Fire              : OFF")
	print(" Sparkles          : OFF")
	print(" Trails            : OFF")
	print(" Beams             : OFF")
	print(" Lights            : OFF")
	print(" Videos            : OFF")
	print(" Animations        : OFF")
	print("----------------------------------------------")
	print(" Heartbeat         : NONE")
	print(" RenderStepped     : NONE")
	print(" Stepped           : NONE")
	print(" DescendantAdded   : NONE")
	print(" Periodic Scan     : NONE")
	print(" Runtime Scanner   : NONE")
	print("----------------------------------------------")
	print(" HARDCORE MODE     : ACTIVE")
	print("==============================================")

end)
